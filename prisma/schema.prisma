  costofsalesid Int      @id @default(autoincrement())
  userid        Int?
  category      String?
  costofsales   Decimal?
  date          DateTime? @db.Date

  user_table user_table? @relation(fields: [userid], references: [userid], onUpdate: Cascade, onDelete: Cascade)
}

model sage_expenses {
  expenseid Int      @id @default(autoincrement())
  userid    Int?
  category  String?
  amount    Decimal?
  date      DateTime? @db.Date

  user_table user_table? @relation(fields: [userid], references: [userid], onUpdate: Cascade, onDelete: Cascade)
}

model sage_revenue {
  revenueid Int      @id @default(autoincrement())
  userid    Int?
  category  String?
  revenue   Decimal?
  date      DateTime? @db.Date

  user_table user_table? @relation(fields: [userid], references: [userid], onUpdate: Cascade, onDelete: Cascade)
}

