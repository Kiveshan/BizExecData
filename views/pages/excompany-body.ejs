<%- include('../partials/ex_navbar') %>

<div id="sidebar">
  <%- include('../partials/ex_sidebar') %>
</div>

<script>
  function attachSidebarHandlers() {
    const buttons = document.querySelectorAll('.button');
    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const href = this.getAttribute('data-href');
        if (href) {
          window.location.href = href;
        }
      });
    });
  }

  function highlightButtons() {
    const url = window.location.pathname.split('/').pop();
    const buttons = document.querySelectorAll('.button');
    buttons.forEach(button => {
      const buttonUrl = button.getAttribute('data-href');
      if (buttonUrl === `/${url}`) {
        button.style.backgroundColor = 'darkgreen';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    attachSidebarHandlers();
    highlightButtons();
  });
</script>

<div class="main-content">
    <h1>Your Business Overview</h1>
    <div class="totals-container">
      <div class="date-card">
        <div class="card-content">
          <p id="totalGrossProfit">Gross Profit: R0</p>
        </div>
      </div>
      <div class="date-card">
        <div class="card-content">
          <p id="totalExpenses">Expenses: R0</p>
        </div>
      </div>
      <div class="date-card">
        <div class="card-content">
          <p id="totalNetProfit">Net Profit: R0</p>
        </div>
      </div>
    </div>

    <div class="chart-container">
      <div class="chart-item">
        <h2>Chart Showing Sales, Cost of Sales and Profit</h2>
        <canvas id="financialChart"></canvas>
      </div>
      <div class="chart-item">
        <h2>Chart Showing Net Profit per Month</h2>
        <canvas id="ProfitChart"></canvas>
      </div>
    </div>

    <div class="filter-dropdowns">
      <div>
        <h3>Select Year</h3>
        <div class="dropdown">
          <select id="yearSelect" class="dropdown-select">
            <option value="">Select Year</option>
          </select>
        </div>
      </div>
      <div>
        <h3>Select Month</h3>
        <div class="dropdown">
          <select id="monthSelect" class="dropdown-select">
            <option value="">Select Month</option>
          </select>
        </div>
      </div>
    </div>

    <div class="filter-container">
      <div>
        <h3>Trends</h3>
        <div class="slider-container">
          <label class="switch">
            <input type="checkbox" id="sixMonthsToggle" checked>
            <span class="slider">
              <span class="slider-text">6 Months</span>
            </span>
          </label>
          <label class="switch">
            <input type="checkbox" id="threeMonthsToggle">
            <span class="slider">
              <span class="slider-text">3 Months</span>
            </span>
          </label>
        </div>
      </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
      let grossData = [];
      let profitData = [];
      let financialChart;
      let ProfitChart;

      function formatMonth(dateString) {
        const date = new Date(dateString);
        return date.toLocaleString('default', { month: 'long' });
      }

      function formatYear(dateString) {
        const date = new Date(dateString);
        return date.getFullYear().toString();
      }

      function formatMonthYear(dateString) {
        const date = new Date(dateString);
        const month = date.toLocaleString('default', { month: 'long' });
        const year = date.getFullYear();
        return `${month} ${year}`;
      }

      function populateYearButtons(years, lastYear) {
        const yearSelect = document.getElementById('yearSelect');
        yearSelect.innerHTML = '<option value="">Select Year</option>';
        const uniqueYears = Array.from(new Set(years));
        uniqueYears.forEach(year => {
          const option = document.createElement('option');
          option.value = year;
          option.textContent = year;
          yearSelect.appendChild(option);
        });
        yearSelect.addEventListener('change', updateCharts);
        yearSelect.value = lastYear;
      }

      function populateMonthButtons(labels, lastMonth) {
        const monthSelect = document.getElementById('monthSelect');
        monthSelect.innerHTML = '<option value="">Select Month</option>';
        const uniqueLabels = Array.from(new Set(labels));
        uniqueLabels.forEach(label => {
          const option = document.createElement('option');
          option.value = label;
          option.textContent = label;
          monthSelect.appendChild(option);
        });
        monthSelect.addEventListener('change', updateCharts);
        monthSelect.value = lastMonth;
      }

      function getSelectedMonths() {
        const monthSelect = document.getElementById('monthSelect');
        return monthSelect.value ? [monthSelect.value] : [];
      }

      function getSelectedYears() {
        const yearSelect = document.getElementById('yearSelect');
        return yearSelect.value ? [yearSelect.value] : [];
      }

      function filterData(selectedMonths, selectedYears, data) {
        return data.filter(row => {
          const rowMonth = formatMonth(row.date);
          const rowYear = formatYear(row.date);
          if (selectedMonths.length === 0 && selectedYears.length === 0) {
            return true;
          }
          if (selectedMonths.length === 0) {
            return selectedYears.includes(rowYear);
          }
          if (selectedYears.length === 0) {
            return selectedMonths.includes(rowMonth);
          }
          return selectedMonths.includes(rowMonth) && selectedYears.includes(rowYear);
        });
      }

      function updateCharts() {
        const selectedMonths = getSelectedMonths();
        const selectedYears = getSelectedYears();
        const filteredFinancialData = filterData(selectedMonths, selectedYears, grossData);
        const filteredProfitData = filterData(selectedMonths, selectedYears, profitData);

        updateFinancialChart(filteredFinancialData);
        updateProfitChart(filteredProfitData);
        calculateTotals(filteredProfitData);

        if (selectedMonths.length > 0 || selectedYears.length > 0) {
          document.getElementById('sixMonthsToggle').checked = false;
          document.getElementById('threeMonthsToggle').checked = false;
        }
      }

      function updateFinancialChart(filteredData) {
        financialChart.data.labels = filteredData.map(row => formatMonthYear(row.date));
        financialChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.netsales.replace(/R|\s/g, '').replace(',', '.')));
        financialChart.data.datasets[1].data = filteredData.map(row => parseFloat(row.costofsales.replace(/R|\s/g, '').replace(',', '.')));
        financialChart.data.datasets[2].data = filteredData.map(row => parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.')));
        financialChart.update();
      }

      function updateProfitChart(filteredData) {
        ProfitChart.data.labels = filteredData.map(row => formatMonthYear(row.date));
        ProfitChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.')));
        ProfitChart.data.datasets[1].data = filteredData.map(row => parseFloat(row.expenses.replace(/R|\s/g, '').replace(',', '.')));
        ProfitChart.data.datasets[2].data = filteredData.map(row => parseFloat(row.otherincome.replace(/R|\s/g, '').replace(',', '.')));
        ProfitChart.data.datasets[3].data = filteredData.map(row => parseFloat(row.netprofit.replace(/R|\s/g, '').replace(',', '.')));
        ProfitChart.update();
      }

      function calculateTotals(data) {
        let totalGrossProfit = 0;
        let totalExpenses = 0;
        let totalNetProfit = 0;

        data.forEach(row => {
          totalGrossProfit += parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.')) || 0;
          totalExpenses += parseFloat(row.expenses.replace(/R|\s/g, '').replace(',', '.')) || 0;
          totalNetProfit += parseFloat(row.netprofit.replace(/R|\s/g, '').replace(',', '.')) || 0;
        });

        function formatNumber(number) {
          return number.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        document.getElementById('totalGrossProfit').textContent = `Gross Profit: R${formatNumber(totalGrossProfit)}`;
        document.getElementById('totalExpenses').textContent = `Expenses: R${formatNumber(totalExpenses)}`;
        document.getElementById('totalNetProfit').textContent = `Net Profit: R${formatNumber(totalNetProfit)}`;
      }

      function getLast6MonthsData(data) {
        const currentDate = new Date();
        const sixMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 6, 1);
        return data.filter(row => new Date(row.date) >= sixMonthsAgo);
      }

      function getLast3MonthsData(data) {
        const currentDate = new Date();
        const threeMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 3, 1);
        return data.filter(row => new Date(row.date) >= threeMonthsAgo);
      }

      function fetchDefaultMonthYear() {
        Promise.all([
          fetch('/api/excompany').then(response => response.json()),
          fetch('/api/exprofit').then(response => response.json())
        ])
        .then(([companyData, profitDataResponse]) => {
          grossData = companyData.financialData;
          profitData = profitDataResponse;
          const lastEntryDate = companyData.lastEntryDate;
          const month = formatMonth(lastEntryDate);
          const year = formatYear(lastEntryDate);
          const labels = grossData.map(row => formatMonth(row.date));
          const years = grossData.map(row => formatYear(row.date));
          populateMonthButtons(labels, month);
          populateYearButtons(years, year);
          initializeCharts(grossData, profitData);
          updateCharts();
        })
        .catch(error => console.error('Error fetching data:', error));
      }

      function initializeCharts(grossData, profitData) {
        const ctx1 = document.getElementById('financialChart').getContext('2d');
        financialChart = new Chart(ctx1, {
          type: 'bar',
          data: {
            labels: grossData.map(row => formatMonthYear(row.date)),
            datasets: [
              {
                label: 'Net Sales',
                data: grossData.map(row => parseFloat(row.netsales.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(75, 100, 150, 1)',
                backgroundColor: 'rgba(75, 100, 150, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Cost of Sales',
                data: grossData.map(row => parseFloat(row.costofsales.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(255, 99, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Gross Profit',
                data: grossData.map(row => parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(153, 102, 255, 1)',
                backgroundColor: 'rgba(153, 102, 255, 0.8)',
                borderWidth: 1
              }
            ]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true
              }
            }
          }
        });

        const ctx2 = document.getElementById('ProfitChart').getContext('2d');
        ProfitChart = new Chart(ctx2, {
          type: 'bar',
          data: {
            labels: profitData.map(row => formatMonthYear(row.date)),
            datasets: [
              {
                label: 'Gross Profit',
                data: profitData.map(row => parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Expenses',
                data: profitData.map(row => parseFloat(row.expenses.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(255, 159, 64, 1)',
                backgroundColor: 'rgba(255, 159, 64, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Other Income',
                data: profitData.map(row => parseFloat(row.otherincome.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(5, 18, 264, 1)',
                backgroundColor: 'rgba(5, 18, 264, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Net Profit',
                data: profitData.map(row => parseFloat(row.netprofit.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(255, 99, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.8)',
                borderWidth: 1
              }
            ]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true
              }
            }
          }
        });

        calculateTotals(profitData);
      }

      function fetchLast6MonthsData() {
        fetch('/api/excompany')
          .then(response => response.json())
          .then(data => {
            grossData = data.financialData;
            const last6MonthsGrossData = getLast6MonthsData(grossData);
            updateFinancialChart(last6MonthsGrossData);
          });

        fetch('/api/exprofit')
          .then(response => response.json())
          .then(data => {
            profitData = data;
            const last6MonthsProfitData = getLast6MonthsData(profitData);
            updateProfitChart(last6MonthsProfitData);
            calculateTotals(last6MonthsProfitData);
          });
      }

      function fetchLast3MonthsData() {
        fetch('/api/excompany')
          .then(response => response.json())
          .then(data => {
            grossData = data.financialData;
            const last3MonthsGrossData = getLast3MonthsData(grossData);
            updateFinancialChart(last3MonthsGrossData);
          });

        fetch('/api/exprofit')
          .then(response => response.json())
          .then(data => {
            profitData = data;
            const last3MonthsProfitData = getLast3MonthsData(profitData);
            updateProfitChart(last3MonthsProfitData);
            calculateTotals(last3MonthsProfitData);
          });
      }

      document.getElementById('sixMonthsToggle').addEventListener('change', function() {
        if (this.checked) {
          document.getElementById('threeMonthsToggle').checked = false;
          document.getElementById('yearSelect').value = '';
          document.getElementById('monthSelect').value = '';
          fetchLast6MonthsData();
        }
      });

      document.getElementById('threeMonthsToggle').addEventListener('change', function() {
        if (this.checked) {
          document.getElementById('sixMonthsToggle').checked = false;
          document.getElementById('yearSelect').value = '';
          document.getElementById('monthSelect').value = '';
          fetchLast3MonthsData();
        }
      });

      fetchDefaultMonthYear();
    });
</script>
