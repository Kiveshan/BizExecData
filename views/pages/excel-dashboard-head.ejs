<link rel="stylesheet" href="styles.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cyan:        #00BDD6;
    --cyan-dark:   #0099B0;
    --cyan-glow:   rgba(0,189,214,0.12);
    --ink:         #0B1120;
    --ink-soft:    #2E3A4A;
    --muted:       #6B7A8D;
    --surface:     #F2F6FA;
    --card-bg:     #FFFFFF;
    --border:      rgba(0,189,214,0.18);
    --danger:      #E53935;
    --radius-lg:   18px;
    --radius-md:   10px;
    --shadow-sm:   0 2px 10px rgba(11,17,32,0.06);
    --shadow-card: 0 4px 24px rgba(11,17,32,0.08);
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--surface);
    color: var(--ink-soft);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* ── Navbar ──────────────────────────────────── */
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
    height: 72px;
    background: #fff;
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 0; z-index: 100;
  }

  .navbar .logo {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .navbar .logo img { height: 44px; width: auto; }

  .navbar .logo h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--cyan);
    letter-spacing: -0.02em;
  }

  .logout-form { margin-left: auto; }

  .logout-button {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border-radius: var(--radius-md);
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    background: var(--danger);
    color: #fff;
    transition: background 0.2s, transform 0.15s;
  }

  .logout-button:hover { background: #B71C1C; transform: translateY(-1px); }

  /* ── Tiles ───────────────────────────────────── */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
    padding: 52px 40px 80px;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    animation: fadeUp 0.5s ease both;
  }

  .tile {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    padding: 34px 26px 26px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    position: relative;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    background: linear-gradient(140deg, var(--cyan-glow) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.25s;
  }

  .tile:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0,189,214,0.15);
    border-color: rgba(0,189,214,0.4);
  }

  .tile:hover::after { opacity: 1; }

  .tile-img-wrap {
    width: 100%;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .tile-img-wrap img { max-width: 100%; max-height: 100%; object-fit: contain; }

  .tile h2 {
    font-family: 'Syne', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .tile-cta {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--cyan);
    position: relative;
    z-index: 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.18s, transform 0.18s;
  }

  .tile:hover .tile-cta { opacity: 1; transform: translateY(0); }

  /* ── Footer ──────────────────────────────────── */
  .footer {
    background: var(--cyan);
    color: #fff;
    text-align: center;
    position: fixed;
    bottom: 0; left: 0;
    width: 100%; height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .alert {
    padding: 13px 24px;
    margin: 0 40px 16px;
    background: #f44336;
    color: #fff;
    border-radius: var(--radius-md);
    display: none;
    font-size: 0.88rem;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
