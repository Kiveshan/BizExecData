<%- include('../partials/xero_navbar') %>

<div id="sidebar">
  <%- include('../partials/xero_sidebar') %>
</div>

<script>
  function attachSidebarHandlers() {
    const buttons = document.querySelectorAll('.button');
    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const href = this.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
  }

  function highlightButtons() {
    const url = window.location.pathname.split('/').pop();
    document.querySelectorAll('.button').forEach(button => {
      if (button.getAttribute('data-href') === url)
        button.style.backgroundColor = '#4a90e2';
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    attachSidebarHandlers();
    highlightButtons();
  });
</script>

<div class="main-content">



  <!-- KPI Cards -->
  <div class="totals-container">
    <div class="date-card">
      <p>Gross Profit</p>
      <div class="kpi-value" id="totalGrossProfit">R0.00</div>
    </div>
    <div class="date-card">
      <p>Expenses</p>
      <div class="kpi-value" id="totalExpenses">R0.00</div>
    </div>
    <div class="date-card">
      <p>Net Profit</p>
      <div class="kpi-value" id="totalNetProfit">R0.00</div>
    </div>
  </div>

  <!-- Filters -->
  <div class="filters-bar">
    <div class="filter-dropdowns">
      <div>
        <h3>Year</h3>
        <div class="dropdown">
          <select id="yearSelect" class="dropdown-select">
            <option value="">All years</option>
          </select>
        </div>
      </div>
      <div>
        <h3>Month</h3>
        <div class="dropdown">
          <select id="monthSelect" class="dropdown-select">
            <option value="">All months</option>
          </select>
        </div>
      </div>
    </div>
    <div class="filter-container">
      <div>
        <h3>Trends</h3>
        <div class="slider-container">
          <label class="switch">
            <input type="checkbox" id="sixMonthsToggle" checked>
            <span class="slider">6 Months</span>
          </label>
          <label class="switch">
            <input type="checkbox" id="threeMonthsToggle">
            <span class="slider">3 Months</span>
          </label>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts stacked -->
  <div class="chart-container">
    <div class="chart-item">
      <h2>Sales, Cost of Sales &amp; Gross Profit</h2>
      <canvas id="financialChart"></canvas>
    </div>
    <div class="chart-item">
      <h2>Net Profit per Month</h2>
      <canvas id="ProfitChart"></canvas>
    </div>
  </div>

</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let grossData = [];
    let profitData = [];
    let financialChart;
    let ProfitChart;

    function formatMonth(dateString) {
      return new Date(dateString).toLocaleString('default', { month: 'long' });
    }
    function formatYear(dateString) {
      return new Date(dateString).getFullYear().toString();
    }
    function formatMonthYear(dateString) {
      const d = new Date(dateString);
      return `${d.toLocaleString('default', { month: 'long' })} ${d.getFullYear()}`;
    }

    function populateYearButtons(years, lastYear) {
      const yearSelect = document.getElementById('yearSelect');
      yearSelect.innerHTML = '<option value="">All years</option>';
      Array.from(new Set(years)).forEach(year => {
        const o = document.createElement('option');
        o.value = year; o.textContent = year;
        yearSelect.appendChild(o);
      });
      yearSelect.addEventListener('change', updateCharts);
      yearSelect.value = lastYear;
    }

    function populateMonthButtons(labels, lastMonth) {
      const monthSelect = document.getElementById('monthSelect');
      monthSelect.innerHTML = '<option value="">All months</option>';
      Array.from(new Set(labels)).forEach(label => {
        const o = document.createElement('option');
        o.value = label; o.textContent = label;
        monthSelect.appendChild(o);
      });
      monthSelect.addEventListener('change', updateCharts);
      monthSelect.value = lastMonth;
    }

    function getSelectedMonths() {
      const v = document.getElementById('monthSelect').value;
      return v ? [v] : [];
    }
    function getSelectedYears() {
      const v = document.getElementById('yearSelect').value;
      return v ? [v] : [];
    }

    function filterData(selectedMonths, selectedYears, data) {
      return data.filter(row => {
        const rm = formatMonth(row.date), ry = formatYear(row.date);
        if (!selectedMonths.length && !selectedYears.length) return true;
        if (!selectedMonths.length) return selectedYears.includes(ry);
        if (!selectedYears.length) return selectedMonths.includes(rm);
        return selectedMonths.includes(rm) && selectedYears.includes(ry);
      });
    }

    function updateCharts() {
      const sm = getSelectedMonths(), sy = getSelectedYears();
      const fg = filterData(sm, sy, grossData);
      const fp = filterData(sm, sy, profitData);
      updateFinancialChart(fg);
      updateProfitChart(fp);
      calculateTotals(fp);
      if (sm.length || sy.length) {
        document.getElementById('sixMonthsToggle').checked = false;
        document.getElementById('threeMonthsToggle').checked = false;
      }
    }

    function updateFinancialChart(d) {
      financialChart.data.labels = d.map(r => formatMonthYear(r.date));
      financialChart.data.datasets[0].data = d.map(r => parseFloat(r.sumofsales.replace(/R|\s/g,'').replace(',','.')));
      financialChart.data.datasets[1].data = d.map(r => parseFloat(r.sumofcost.replace(/R|\s/g,'').replace(',','.')));
      financialChart.data.datasets[2].data = d.map(r => parseFloat(r.grossprofit.replace(/R|\s/g,'').replace(',','.')));
      financialChart.update();
    }

    function updateProfitChart(d) {
      ProfitChart.data.labels = d.map(r => formatMonthYear(r.date));
      ProfitChart.data.datasets[0].data = d.map(r => parseFloat(r.grossprofit.replace(/R|\s/g,'').replace(',','.')));
      ProfitChart.data.datasets[1].data = d.map(r => parseFloat(r.opexpenses.replace(/R|\s/g,'').replace(',','.')));
      ProfitChart.data.datasets[2].data = d.map(r => parseFloat(r.netprofit.replace(/R|\s/g,'').replace(',','.')));
      ProfitChart.update();
    }

    function calculateTotals(data) {
      let gp = 0, ex = 0, np = 0;
      data.forEach(r => {
        gp += parseFloat(r.grossprofit.replace(/R|\s/g,'').replace(',','.')) || 0;
        ex += parseFloat(r.opexpenses.replace(/R|\s/g,'').replace(',','.')) || 0;
        np += parseFloat(r.netprofit.replace(/R|\s/g,'').replace(',','.')) || 0;
      });
      const fmt = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      document.getElementById('totalGrossProfit').textContent = `R${fmt(gp)}`;
      document.getElementById('totalExpenses').textContent   = `R${fmt(ex)}`;
      document.getElementById('totalNetProfit').textContent   = `R${fmt(np)}`;
    }

    function getLast6MonthsData(data) {
      const ago = new Date(); ago.setMonth(ago.getMonth() - 6);
      return data.filter(r => new Date(r.date) >= ago);
    }
    function getLast3MonthsData(data) {
      const ago = new Date(); ago.setMonth(ago.getMonth() - 3);
      return data.filter(r => new Date(r.date) >= ago);
    }

    const chartDefaults = {
      responsive: true,
      plugins: { legend: { labels: { font: { family: 'DM Sans', size: 12 }, color: '#2E3A4A' } } },
      scales: {
        x: { grid: { color: 'rgba(0,189,214,0.07)' }, ticks: { font: { family: 'DM Sans', size: 11 }, color: '#6B7A8D' } },
        y: { beginAtZero: true, grid: { color: 'rgba(0,189,214,0.07)' }, ticks: { font: { family: 'DM Sans', size: 11 }, color: '#6B7A8D' } }
      }
    };

    function initializeCharts(grossData, profitData) {
      const ctx1 = document.getElementById('financialChart').getContext('2d');
      financialChart = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: grossData.map(r => formatMonthYear(r.date)),
          datasets: [
            { label: 'Sales',        data: grossData.map(r => parseFloat(r.sumofsales.replace(/R|\s/g,'').replace(',','.'))),  borderColor: '#00BDD6', backgroundColor: 'rgba(0,189,214,0.75)',   borderWidth: 1 },
            { label: 'Cost of Sales',data: grossData.map(r => parseFloat(r.sumofcost.replace(/R|\s/g,'').replace(',','.'))),   borderColor: '#F97066', backgroundColor: 'rgba(249,112,102,0.75)', borderWidth: 1 },
            { label: 'Gross Profit', data: grossData.map(r => parseFloat(r.grossprofit.replace(/R|\s/g,'').replace(',','.'))), borderColor: '#A78BFA', backgroundColor: 'rgba(167,139,250,0.75)', borderWidth: 1 }
          ]
        },
        options: chartDefaults
      });

      const ctx2 = document.getElementById('ProfitChart').getContext('2d');
      ProfitChart = new Chart(ctx2, {
        type: 'bar',
        data: {
          labels: profitData.map(r => formatMonthYear(r.date)),
          datasets: [
            { label: 'Gross Profit', data: profitData.map(r => parseFloat(r.grossprofit.replace(/R|\s/g,'').replace(',','.'))), borderColor: '#00BDD6', backgroundColor: 'rgba(0,189,214,0.75)',   borderWidth: 1 },
            { label: 'Expenses',     data: profitData.map(r => parseFloat(r.opexpenses.replace(/R|\s/g,'').replace(',','.'))),  borderColor: '#FBBF24', backgroundColor: 'rgba(251,191,36,0.75)',  borderWidth: 1 },
            { label: 'Net Profit',   data: profitData.map(r => parseFloat(r.netprofit.replace(/R|\s/g,'').replace(',','.'))),   borderColor: '#34D399', backgroundColor: 'rgba(52,211,153,0.75)',  borderWidth: 1 }
          ]
        },
        options: chartDefaults
      });

      calculateTotals(profitData);
    }

    function fetchDefaultMonthYear() {
      Promise.all([
        fetch('/api/xerocompany').then(r => r.json()),
        fetch('/api/xeroprofit').then(r => r.json())
      ])
      .then(([companyData, profitDataResponse]) => {
        grossData = companyData.data;
        profitData = profitDataResponse;
        const lastEntryDate = companyData.lastEntryDate;
        const month = formatMonth(lastEntryDate), year = formatYear(lastEntryDate);
        const labels = grossData.map(r => formatMonth(r.date));
        const years  = grossData.map(r => formatYear(r.date));
        populateMonthButtons(labels, month);
        populateYearButtons(years, year);
        initializeCharts(grossData, profitData);
        updateCharts();
      })
      .catch(err => console.error('Error fetching data:', err));
    }

    function fetchLast6MonthsData() {
      fetch('/api/xerocompany').then(r => r.json()).then(data => { grossData = data.data; updateFinancialChart(getLast6MonthsData(grossData)); });
      fetch('/api/xeroprofit').then(r => r.json()).then(data => { profitData = data; const d = getLast6MonthsData(profitData); updateProfitChart(d); calculateTotals(d); });
    }
    function fetchLast3MonthsData() {
      fetch('/api/xerocompany').then(r => r.json()).then(data => { grossData = data.data; updateFinancialChart(getLast3MonthsData(grossData)); });
      fetch('/api/xeroprofit').then(r => r.json()).then(data => { profitData = data; const d = getLast3MonthsData(profitData); updateProfitChart(d); calculateTotals(d); });
    }

    document.getElementById('sixMonthsToggle').addEventListener('change', function() {
      if (this.checked) { document.getElementById('threeMonthsToggle').checked = false; document.getElementById('yearSelect').value = ''; document.getElementById('monthSelect').value = ''; fetchLast6MonthsData(); }
    });
    document.getElementById('threeMonthsToggle').addEventListener('change', function() {
      if (this.checked) { document.getElementById('sixMonthsToggle').checked = false; document.getElementById('yearSelect').value = ''; document.getElementById('monthSelect').value = ''; fetchLast3MonthsData(); }
    });

    fetchDefaultMonthYear();
  });
</script>
