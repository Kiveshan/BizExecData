<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css">
<style>
/* ─── Reset & Base ─────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --cyan:        #00BDD6;
  --cyan-dark:   #0099B0;
  --cyan-glow:   rgba(0, 189, 214, 0.12);
  --ink:         #0B1120;
  --ink-soft:    #2E3A4A;
  --muted:       #6B7A8D;
  --surface:     #F2F6FA;
  --card-bg:     #FFFFFF;
  --border:      rgba(0, 189, 214, 0.18);
  --radius-lg:   18px;
  --radius-md:   12px;
  --shadow-card: 0 4px 24px rgba(11,17,32,0.08);
}

body {
  background-color: var(--surface);
  font-family: 'DM Sans', sans-serif;
  color: var(--ink-soft);
  overflow-x: hidden;
  min-height: 100vh;
}

/* ─── Navbar ────────────────────────────────────────────── */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40px;
  height: 72px;
  background: #fff;
  border-bottom: 1px solid var(--border);
  box-shadow: 0 2px 10px rgba(11,17,32,0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.navbar .logo {
  display: flex;
  align-items: center;
  gap: 14px;
  text-decoration: none;
}

.navbar .logo img {
  height: 44px;
  width: auto;
}

.navbar .logo-text {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.navbar .logo-text .brand {
  font-family: 'Syne', sans-serif;
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--cyan);
  letter-spacing: -0.02em;
  line-height: 1;
}

.navbar .logo-text .tagline {
  font-size: 0.65rem;
  font-weight: 400;
  color: var(--muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.navbar .nav-links {
  list-style: none;
  display: flex;
  gap: 10px;
}

.navbar .nav-links li a {
  text-decoration: none;
  color: #fff;
  font-weight: 600;
  font-size: 0.85rem;
  padding: 9px 22px;
  background-color: var(--cyan);
  border-radius: 9px;
  letter-spacing: 0.01em;
  transition: background-color 0.2s, transform 0.15s;
  display: inline-block;
}

.navbar .nav-links li a:hover {
  background-color: var(--cyan-dark);
  transform: translateY(-1px);
}

/* ─── Hero ──────────────────────────────────────────────── */
.hero {
  padding: 60px 48px 44px;
  max-width: 860px;
  margin: 0 auto;
  text-align: center;
  animation: fadeUp 0.55s ease both;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--cyan);
  background: var(--cyan-glow);
  border: 1px solid var(--border);
  border-radius: 100px;
  padding: 5px 16px;
  margin-bottom: 22px;
}

.hero-eyebrow::before {
  content: '';
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--cyan);
  animation: dot-pulse 2s infinite;
  flex-shrink: 0;
}

.hero h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(1.9rem, 4.5vw, 2.9rem);
  font-weight: 800;
  color: var(--ink);
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-bottom: 16px;
}

.hero h1 em {
  font-style: normal;
  color: var(--cyan);
}

.hero p {
  font-size: 1rem;
  font-weight: 400;
  color: var(--muted);
  line-height: 1.8;
  max-width: 560px;
  margin: 0 auto;
}

/* ─── Section Label ─────────────────────────────────────── */
.section-label {
  text-align: center;
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 26px;
  animation: fadeUp 0.55s 0.15s ease both;
}

/* ─── Tiles ─────────────────────────────────────────────── */
.tiles {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 22px;
  padding: 0 40px 110px;
  max-width: 1060px;
  margin: 0 auto;
  animation: fadeUp 0.55s 0.25s ease both;
}

.tile {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-card);
  padding: 34px 26px 26px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  position: relative;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.tile::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
  background: linear-gradient(140deg, rgba(0,189,214,0.08) 0%, transparent 55%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tile:hover {
  transform: translateY(-7px);
  box-shadow: 0 18px 44px rgba(0,189,214,0.16);
  border-color: rgba(0,189,214,0.42);
}

.tile:hover::after {
  opacity: 1;
}

.tile-img-wrap {
  width: 100%;
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.tile-img-wrap img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.tile-label {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--muted);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  position: relative;
  z-index: 1;
}

.tile-cta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--cyan);
  position: relative;
  z-index: 1;
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.2s, transform 0.2s;
}

.tile:hover .tile-cta {
  opacity: 1;
  transform: translateY(0);
}

/* ─── Alert ─────────────────────────────────────────────── */
.alert {
  padding: 13px 24px;
  margin: 0 40px 16px;
  background: #f44336;
  color: white;
  border-radius: var(--radius-md);
  display: none;
  font-size: 0.88rem;
  font-weight: 500;
}

/* ─── Footer ─────────────────────────────────────────────── */
.footer {
  background: var(--cyan);
  color: white;
  text-align: center;
  position: fixed;
  bottom: 0; left: 0;
  width: 100%;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.73rem;
  font-weight: 500;
  letter-spacing: 0.03em;
  transition: left 0.3s, width 0.3s;
}

.footer.shifted {
  left: 250px;
  width: calc(100% - 250px);
}

/* ─── Animations ─────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.45; transform: scale(0.75); }
}

/* ─── Responsive ─────────────────────────────────────────── */
@media (max-width: 640px) {
  .navbar { padding: 0 20px; }
  .hero   { padding: 36px 22px 30px; }
  .tiles  { padding: 0 18px 110px; gap: 14px; }
  .alert  { margin: 0 18px 14px; }
}
</style>
