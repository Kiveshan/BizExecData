<%- include('../partials/xero_navbar') %>

<div id="sidebar">
  <%- include('../partials/xero_sidebar') %>
</div>

<script>
  function attachSidebarHandlers() {
      const buttons = document.querySelectorAll('.button');
      buttons.forEach(button => {
          button.addEventListener('click', function() {
              const href = this.getAttribute('data-href');
              if (href) {
                  window.location.href = href;
              }
          });
      });
  }

  function highlightButtons() {
      const url = window.location.pathname.split('/').pop();
      const buttons = document.querySelectorAll('.button');
      buttons.forEach(button => {
          const buttonUrl = button.getAttribute('data-href');
          if (buttonUrl === url) {
              button.style.backgroundColor = '#4a90e2';
          }
      });
  }

  document.addEventListener('DOMContentLoaded', function () {
    attachSidebarHandlers();
    highlightButtons();
  });
</script>

<div class="main-content">
    <h1>Your Revenue Overview</h1>

    <div class="chart-container">
        <div class="chart-item">
            <h2>Chart Showing Revenue and Cost per Month</h2>
            <canvas id="financialChart"></canvas>
        </div>
        <div class="chart-item">
            <h2>Chart Showing Revenue</h2>
            <canvas id="salesChart"></canvas>
        </div>
        <div class="chart-item">
            <h2>Chart Showing Cost of Sales</h2>
            <canvas id="costofsalesChart"></canvas>
        </div>
    </div>

    <div class="filter-dropdowns">
      <div>
        <h3>Select Year</h3>
        <div class="dropdown">
          <select id="yearSelect" class="dropdown-select">
            <option value="">Select Year</option>
          </select>
        </div>
      </div>
      <div>
        <h3>Select Month</h3>
        <div class="dropdown">
          <select id="monthSelect" class="dropdown-select">
            <option value="">Select Month</option>
          </select>
        </div>
      </div>
    </div>

    <div class="filter-container">
        <div>
            <h3>Trends</h3>
            <div class="slider-container">
              <label class="switch">
                <input type="checkbox" id="sixMonthsToggle" checked>
                <span class="slider">
                  <span class="slider-text">6 Months</span>
                </span>
              </label>
              <label class="switch">
                <input type="checkbox" id="threeMonthsToggle">
                <span class="slider">
                  <span class="slider-text">3 Months</span>
                </span>
              </label>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
      let salesData = [];
      let grossData = [];
      let costofsalesData = [];
      let salesChart, financialChart, costofsalesChart;

      function formatMonth(dateString) {
        const date = new Date(dateString);
        return date.toLocaleString('default', { month: 'long' });
      }

      function formatYear(dateString) {
        const date = new Date(dateString);
        return date.getFullYear().toString();
      }

      function formatMonthYear(dateString) {
        const date = new Date(dateString);
        const month = date.toLocaleString('default', { month: 'long' });
        const year = date.getFullYear();
        return `${month} ${year}`;
      }

      function formatFullDate(dateString) {
        const date = new Date(dateString);
        const day = date.getDate();
        const month = date.toLocaleString('default', { month: 'long' });
        const year = date.getFullYear();
        return `${day} ${month} ${year}`;
      }

      function populateYearSelect(years, lastYear) {
        const yearSelect = document.getElementById('yearSelect');
        yearSelect.innerHTML = '<option value="">Select Year</option>';
        const uniqueYears = Array.from(new Set(years));
        uniqueYears.forEach(year => {
          const option = document.createElement('option');
          option.value = year;
          option.textContent = year;
          yearSelect.appendChild(option);
        });
        yearSelect.addEventListener('change', updateCharts);
        yearSelect.value = lastYear;
      }

      function populateMonthSelect(labels, lastMonth) {
        const monthSelect = document.getElementById('monthSelect');
        monthSelect.innerHTML = '<option value="">Select Month</option>';
        const uniqueLabels = Array.from(new Set(labels));
        uniqueLabels.forEach(label => {
          const option = document.createElement('option');
          option.value = label;
          option.textContent = label;
          monthSelect.appendChild(option);
        });
        monthSelect.addEventListener('change', updateCharts);
        monthSelect.value = lastMonth;
      }

      function getSelectedMonths() {
        const monthSelect = document.getElementById('monthSelect');
        return monthSelect.value ? [monthSelect.value] : [];
      }

      function getSelectedYears() {
        const yearSelect = document.getElementById('yearSelect');
        return yearSelect.value ? [yearSelect.value] : [];
      }

      function filterData(selectedMonths, selectedYears, data) {
        return data.filter(row => {
          const rowMonth = formatMonth(row.date);
          const rowYear = formatYear(row.date);
          if (selectedMonths.length === 0 && selectedYears.length === 0) {
            return true;
          }
          if (selectedMonths.length === 0) {
            return selectedYears.includes(rowYear);
          }
          if (selectedYears.length === 0) {
            return selectedMonths.includes(rowMonth);
          }
          return selectedMonths.includes(rowMonth) && selectedYears.includes(rowYear);
        });
      }

      function updateCharts() {
        const selectedMonths = getSelectedMonths();
        const selectedYears = getSelectedYears();
        const filteredSalesData = filterData(selectedMonths, selectedYears, salesData);
        const filteredGrossData = filterData(selectedMonths, selectedYears, grossData);
        const filteredCostofSalesData = filterData(selectedMonths, selectedYears, costofsalesData);

        updatesalesChart(filteredSalesData);
        updateFinancialChart(filteredGrossData);
        updateCostofSalesChart(filteredCostofSalesData);

        if (selectedMonths.length > 0 || selectedYears.length > 0) {
          document.getElementById('sixMonthsToggle').checked = false;
          document.getElementById('threeMonthsToggle').checked = false;
        }
      }

      function updatesalesChart(filteredData) {
        salesChart.data.labels = filteredData.map(row => row.category);
        salesChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.revenue.replace(/R|\s/g, '').replace(',', '.')));
        salesChart.update();
      }

      function updateFinancialChart(filteredData) {
        financialChart.data.labels = filteredData.map(row => formatMonthYear(row.date));
        financialChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.sumofsales.replace(/R|\s/g, '').replace(',', '.')));
        financialChart.data.datasets[1].data = filteredData.map(row => parseFloat(row.sumofcost.replace(/R|\s/g, '').replace(',', '.')));
        financialChart.update();
      }

      function updateCostofSalesChart(filteredData) {
        costofsalesChart.data.labels = filteredData.map(row => formatFullDate(row.date));
        costofsalesChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.costofsales.replace(/R|\s/g, '').replace(',', '.')));
        costofsalesChart.update();
      }

      function getLast6MonthsData(data) {
        const currentDate = new Date();
        const sixMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 6, 1);
        return data.filter(row => new Date(row.date) >= sixMonthsAgo);
      }

      function getLast3MonthsData(data) {
        const currentDate = new Date();
        const threeMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 3, 1);
        return data.filter(row => new Date(row.date) >= threeMonthsAgo);
      }

      function fetchDefaultMonthYear() {
        Promise.all([
          fetch('/api/xerorevenue').then(response => response.json()),
          fetch('/api/xerocompany').then(response => response.json()),
          fetch('/api/xerocostofsales').then(response => response.json())
        ])
        .then(([revenueData, companyData, costOfSalesData]) => {
          salesData = revenueData;
          grossData = companyData.data;
          costofsalesData = costOfSalesData;

          const lastEntryDate = companyData.lastEntryDate;
          const month = formatMonth(lastEntryDate);
          const year = formatYear(lastEntryDate);
          const labels = grossData.map(row => formatMonth(row.date));
          const years = grossData.map(row => formatYear(row.date));
          populateMonthSelect(labels, month);
          populateYearSelect(years, year);
          initializeCharts(grossData, salesData, costofsalesData);
          updateCharts();
        })
        .catch(error => console.error('Error fetching data:', error));
      }

      function initializeCharts(grossData, salesData, costofsalesData) {
        const ctx1 = document.getElementById('financialChart').getContext('2d');
        financialChart = new Chart(ctx1, {
          type: 'bar',
          data: {
            labels: grossData.map(row => formatMonthYear(row.date)),
            datasets: [
              {
                label: 'Sales',
                data: grossData.map(row => parseFloat(row.sumofsales.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(75, 19, 192, 1)',
                backgroundColor: 'rgba(75, 19, 192, 0.8)',
                borderWidth: 1
              },
              {
                label: 'Cost of Sales',
                data: grossData.map(row => parseFloat(row.sumofcost.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(255, 0, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.8)',
                borderWidth: 1
              }
            ]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true
              }
            }
          }
        });

        const ctx2 = document.getElementById('salesChart').getContext('2d');
        salesChart = new Chart(ctx2, {
          type: 'bar',
          data: {
            labels: salesData.map(row => row.category),
            datasets: [
              {
                label: 'Revenue',
                data: salesData.map(row => parseFloat(row.revenue.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.8)',
                borderWidth: 1
              }
            ]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true
              }
            }
          }
        });

        const ctx3 = document.getElementById('costofsalesChart').getContext('2d');
        costofsalesChart = new Chart(ctx3, {
          type: 'bar',
          data: {
            labels: costofsalesData.map(row => formatFullDate(row.date)),
            datasets: [
              {
                label: 'Cost of Revenue',
                data: costofsalesData.map(row => parseFloat(row.costofsales.replace(/R|\s/g, '').replace(',', '.'))),
                borderColor: 'rgba(25, 0, 30, 1)',
                backgroundColor: 'rgba(25, 0, 30, 0.8)',
                borderWidth: 1
              }
            ]
          },
          options: {
            scales: {
              y: {
                beginAtZero: true
              }
            }
          }
        });
      }

      document.getElementById('sixMonthsToggle').addEventListener('change', function() {
        if (this.checked) {
          document.getElementById('threeMonthsToggle').checked = false;
          document.getElementById('yearSelect').value = '';
          document.getElementById('monthSelect').value = '';
          const last6MonthsGrossData = getLast6MonthsData(grossData);
          const last6MonthsSalesData = getLast6MonthsData(salesData);
          const last6MonthsCostOfSalesData = getLast6MonthsData(costofsalesData);
          updateFinancialChart(last6MonthsGrossData);
          updatesalesChart(last6MonthsSalesData);
          updateCostofSalesChart(last6MonthsCostOfSalesData);
        }
      });

      document.getElementById('threeMonthsToggle').addEventListener('change', function() {
        if (this.checked) {
          document.getElementById('sixMonthsToggle').checked = false;
          document.getElementById('yearSelect').value = '';
          document.getElementById('monthSelect').value = '';
          const last3MonthsGrossData = getLast3MonthsData(grossData);
          const last3MonthsSalesData = getLast3MonthsData(salesData);
          const last3MonthsCostOfSalesData = getLast3MonthsData(costofsalesData);
          updateFinancialChart(last3MonthsGrossData);
          updatesalesChart(last3MonthsSalesData);
          updateCostofSalesChart(last3MonthsCostOfSalesData);
        }
      });

      fetchDefaultMonthYear();
    });
</script>
