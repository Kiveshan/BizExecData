<header>
    <nav class="navbar">
        <div class="logo">
            <img src="logo_biz.png" alt="Navbar Logo">
            <h3>Business Executive<br><span>Accurate Analytics, Digestible Visualizations, Live Dashboards</span></h3>
        </div>
    </nav>
</header>

<main>
    <h2><span>W</span>elcome to Business Executive. Our dashboards provide real-time visualizations of your business performance to support informed decision making. Dynamic financial dashboards provide instant insights for data driven decision making.</h2>
    <div id="message-box" class="alert"></div>
    <div class="dashboard-image">
        <img src="Analytics.png" alt="Dashboard and Analytics">
    </div>
    <div class="tiles">
        <a href="/auth">
            <div class="tile">
                <img src="quickbooks-brand-preferred-logo-50-50-black-external.png" alt="Quickbooks Login">
                <h2><img src="C2QB_green_btn_short_default_2x.png" alt=""></h2>
            </div>
        </a>
        <a href="xero-connect" style="text-decoration: none;">
            <div class="tile">
                <img src="Xero.jpg" alt="Xero Login">
                <h2>Xero Login</h2>
            </div>
        </a>
        <a href="login" style="text-decoration: none;">
            <div class="tile">
                <img src="Excel2.jpg" alt="Excel Login">
                <h2>Excel Login</h2>
            </div>
        </a>

        <a href="sagelogin" style="text-decoration: none;">
            <div class="tile">
                <img src="Sage.png" alt="Sage Login">
                <h2>Sage Login</h2>
            </div>
        </a>
    </div>

    <%- include('../partials/footer') %>

    <script>
        // Function to get query parameters
        function getQueryParam(param) {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }

        // Check if the message parameter is in the URL
        const message = getQueryParam('message');
        if (message) {
            // Show the message if it's present
            const messageBox = document.getElementById('message-box');
            messageBox.textContent = message;
            messageBox.style.display = 'block';

            // Auto-hide the message after 3 seconds
            setTimeout(() => {
                messageBox.style.display = 'none';
            }, 3000); // 3 seconds
        }
    </script>
</main>
