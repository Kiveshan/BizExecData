<%- include('../partials/ex_navbar') %>

<div id="sidebar">
  <%- include('../partials/ex_sidebar') %>
</div>

<script>
  function attachSidebarHandlers() {
    const buttons = document.querySelectorAll('.button');
    buttons.forEach(button => {
      button.addEventListener('click', function() {
        const href = this.getAttribute('data-href');
        if (href) {
          window.location.href = href;
        }
      });
    });
  }

  function highlightButtons() {
    const url = window.location.pathname.split('/').pop();
    const buttons = document.querySelectorAll('.button');
    buttons.forEach(button => {
      const buttonUrl = button.getAttribute('data-href');
      if (buttonUrl === `/${url}`) {
        button.style.backgroundColor = 'darkgreen';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    attachSidebarHandlers();
    highlightButtons();
  });
</script>

<div class="main-content">
    <div class="chart-container">
        <div class="chart-item">
            <h2>Chart Showing All Business Income vs Net Profit per Month</h2>
            <canvas id="ProfitChart"></canvas>
        </div>
        <div class="chart-item">
            <h2>Chart Showing Additional Income</h2>
            <canvas id="incomeChart"></canvas>
        </div>
    </div>

    <div class="filter-dropdowns">
      <div>
          <h3>Select Year</h3>
          <div class="dropdown">
              <select id="yearSelect" class="dropdown-select">
                  <option value="">Select Year</option>
              </select>
          </div>
      </div>

      <div>
          <h3>Select Month</h3>
          <div class="dropdown">
              <select id="monthSelect" class="dropdown-select">
                  <option value="">Select Month</option>
              </select>
          </div>
      </div>
    </div>

    <div class="filter-container">
        <div>
            <h3>Trends</h3>
            <div class="slider-container">
                <label class="switch">
                    <input type="checkbox" id="sixMonthsToggle">
                    <span class="slider">
                        <span class="slider-text">6 Months</span>
                    </span>
                </label>
                <label class="switch">
                    <input type="checkbox" id="threeMonthsToggle">
                    <span class="slider">
                        <span class="slider-text">3 Months</span>
                    </span>
                </label>
            </div>
        </div>

    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let profitData = [];
    let incomeData = [];
    let ProfitChart;
    let incomeChart;

    function formatMonthYear(dateString) {
      const date = new Date(dateString);
      const month = date.toLocaleString('default', { month: 'long' });
      const year = date.getFullYear();
      return `${month} ${year}`;
    }

    function formatMonth(dateString) {
      const date = new Date(dateString);
      return date.toLocaleString('default', { month: 'long' });
    }

    function formatYear(dateString) {
      const date = new Date(dateString);
      return date.getFullYear().toString();
    }

    function populateYearButtons(years, lastYear) {
      const yearSelect = document.getElementById('yearSelect');
      yearSelect.innerHTML = '<option value="">Select Year</option>';
      const uniqueYears = Array.from(new Set(years));
      uniqueYears.forEach(year => {
        const option = document.createElement('option');
        option.value = year;
        option.textContent = year;
        yearSelect.appendChild(option);
      });
      yearSelect.addEventListener('change', updateCharts);
      yearSelect.value = lastYear;
    }

    function populateMonthButtons(labels, lastMonth) {
      const monthSelect = document.getElementById('monthSelect');
      monthSelect.innerHTML = '<option value="">Select Month</option>';
      const uniqueLabels = Array.from(new Set(labels));
      uniqueLabels.forEach(label => {
        const option = document.createElement('option');
        option.value = label;
        option.textContent = label;
        monthSelect.appendChild(option);
      });
      monthSelect.addEventListener('change', updateCharts);
      monthSelect.value = lastMonth;
    }

    function getSelectedMonths() {
      const monthSelect = document.getElementById('monthSelect');
      return monthSelect.value ? [monthSelect.value] : [];
    }

    function getSelectedYears() {
      const yearSelect = document.getElementById('yearSelect');
      return yearSelect.value ? [yearSelect.value] : [];
    }

    function filterData(selectedMonths, selectedYears, data) {
      return data.filter(row => {
        const rowMonth = formatMonthYear(row.date).split(' ')[0];
        const rowYear = formatMonthYear(row.date).split(' ')[1];
        if (selectedMonths.length === 0 && selectedYears.length === 0) {
          return true;
        }
        if (selectedMonths.length === 0) {
          return selectedYears.includes(rowYear);
        }
        if (selectedYears.length === 0) {
          return selectedMonths.includes(rowMonth);
        }
        return selectedMonths.includes(rowMonth) && selectedYears.includes(rowYear);
      });
    }

    function updateCharts() {
      const selectedMonths = getSelectedMonths();
      const selectedYears = getSelectedYears();
      const filteredProfitData = filterData(selectedMonths, selectedYears, profitData);
      const filteredIncomeData = filterData(selectedMonths, selectedYears, incomeData);
      updateProfitChart(filteredProfitData);
      updateIncomeChart(filteredIncomeData);

      if (selectedMonths.length > 0 || selectedYears.length > 0) {
        document.getElementById('sixMonthsToggle').checked = false;
        document.getElementById('threeMonthsToggle').checked = false;
      }
    }

    function updateProfitChart(filteredData) {
      ProfitChart.data.labels = filteredData.map(row => formatMonthYear(row.date));
      ProfitChart.data.datasets[0].data = filteredData.map(row => parseFloat(row.grossprofit.replace(/R|\s/g, '').replace(',', '.')));
      ProfitChart.data.datasets[1].data = filteredData.map(row => parseFloat(row.otherincome.replace(/R|\s/g, '').replace(',', '.')));
      ProfitChart.data.datasets[2].data = filteredData.map(row => parseFloat(row.netprofit.replace(/R|\s/g, '').replace(',', '.')));
      ProfitChart.update();
    }

    function aggregateIncomeData(data) {
      const aggregated = {};
      data.forEach(row => {
        const subcategory = row.subcategory;
        const amount = parseFloat(row.amount.replace(/R|\s/g, '').replace(',', '.'));
        if (!aggregated[subcategory]) {
          aggregated[subcategory] = 0;
        }
        aggregated[subcategory] += amount;
      });
      return Object.keys(aggregated).map(subcategory => ({
        subcategory,
        amount: aggregated[subcategory]
      }));
    }

    function updateIncomeChart(filteredData) {
      const aggregatedData = aggregateIncomeData(filteredData);
      incomeChart.data.labels = aggregatedData.map(row => row.subcategory);
      incomeChart.data.datasets[0].data = aggregatedData.map(row => row.amount);
      incomeChart.update();
    }

    function getLast6MonthsData(data) {
      const currentDate = new Date();
      const sixMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 6, 1);
      return data.filter(row => new Date(row.date) >= sixMonthsAgo);
    }

    function getLast3MonthsData(data) {
      const currentDate = new Date();
      const threeMonthsAgo = new Date(currentDate.getFullYear(), currentDate.getMonth() - 3, 1);
      return data.filter(row => new Date(row.date) >= threeMonthsAgo);
    }

    function fetchDefaultMonthYear() {
      Promise.all([
        fetch('/api/exprofit').then(response => response.json()),
        fetch('/api/ex_income').then(response => response.json())
      ])
      .then(([profitDataResponse, incomeDataResponse]) => {
        profitData = profitDataResponse;
        incomeData = incomeDataResponse.incomeData;
        const lastEntryDate = incomeDataResponse.lastEntryDate;
        const month = formatMonth(lastEntryDate);
        const year = formatYear(lastEntryDate);
        const labels = profitData.map(row => formatMonth(row.date));
        const years = profitData.map(row => formatYear(row.date));
        populateMonthButtons(labels, month);
        populateYearButtons(years, year);
        initializeCharts(profitData, incomeData);
        updateCharts();
      })
      .catch(error => console.error('Error fetching data:', error));
    }

    function initializeCharts(profitData, incomeData) {
      const ctx1 = document.getElementById('ProfitChart').getContext('2d');
      ProfitChart = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Gross Profit',
              data: [],
              borderColor: 'rgba(140, 7, 105, 1)',
              backgroundColor: 'rgba(140, 7, 105, 0.8)',
              borderWidth: 1
            },
            {
              label: 'Operating Income',
              data: [],
              borderColor: 'rgba(46, 7, 105, 1)',
              backgroundColor: 'rgba(46, 7, 105, 0.8)',
              borderWidth: 1
            },
            {
              label: 'Net Profit',
              data: [],
              borderColor: 'rgba(58, 163, 187, 1)',
              backgroundColor: 'rgba(58, 163, 187, 0.8)',
              borderWidth: 1
            }
          ]
        },
        options: {
          scales: {
            y: {
              beginAtZero: true
            }
          }
        }
      });

      const ctx2 = document.getElementById('incomeChart').getContext('2d');
      incomeChart = new Chart(ctx2, {
        type: 'bar',
        data: {
          labels: [],
          datasets: [
            {
              label: 'Additional Income',
              data: [],
              borderColor: 'rgba(52, 219, 192, 1)',
              backgroundColor: 'rgba(52, 219, 192, 0.8)',
              borderWidth: 1
            }
          ]
        },
        options: {
          scales: {
            y: {
              beginAtZero: true
            }
          }
        }
      });

      updateProfitChart(profitData);
      updateIncomeChart(incomeData);
    }

    document.getElementById('sixMonthsToggle').addEventListener('change', function() {
      if (this.checked) {
        document.getElementById('threeMonthsToggle').checked = false;
        document.getElementById('yearSelect').value = '';
        document.getElementById('monthSelect').value = '';
        updateProfitChart(getLast6MonthsData(profitData));
        updateIncomeChart(getLast6MonthsData(incomeData));
      }
    });

    document.getElementById('threeMonthsToggle').addEventListener('change', function() {
      if (this.checked) {
        document.getElementById('sixMonthsToggle').checked = false;
        document.getElementById('yearSelect').value = '';
        document.getElementById('monthSelect').value = '';
        updateProfitChart(getLast3MonthsData(profitData));
        updateIncomeChart(getLast3MonthsData(incomeData));
      }
    });

    fetchDefaultMonthYear();
  });
</script>
