<link rel="stylesheet" href="style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cyan:       #00BDD6;
    --cyan-dark:  #0099B0;
    --cyan-glow:  rgba(0,189,214,0.10);
    --ink:        #0B1120;
    --ink-soft:   #2E3A4A;
    --muted:      #6B7A8D;
    --surface:    #F2F6FA;
    --card-bg:    #FFFFFF;
    --border:     rgba(0,189,214,0.18);
    --radius-lg:  16px;
    --radius-md:  10px;
    --shadow-card: 0 4px 20px rgba(11,17,32,0.07);

    /* Chart palette — consistent across all pages */
    --c1: #00BDD6;
    --c2: #F97066;
    --c3: #A78BFA;
    --c4: #34D399;
    --c5: #FBBF24;
  }

  /* ── Page shell ──────────────────────────────── */
  .main-content {
    padding: 28px 32px 80px;
    font-family: 'DM Sans', sans-serif;
    animation: fadeUp 0.45s ease both;
  }

  /* ── Page title ──────────────────────────────── */
  .main-content > h1 {
    font-family: 'Syne', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }

  /* ── KPI cards ───────────────────────────────── */
  .totals-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
  }

  .date-card {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    padding: 20px 22px;
    position: relative;
    overflow: hidden;
  }

  .date-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 4px; height: 100%;
    background: var(--cyan);
    border-radius: 4px 0 0 4px;
  }

  .date-card p {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .date-card .kpi-value {
    font-family: 'Syne', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  /* ── Chart grid ──────────────────────────────── */
  .chart-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 28px;
  }

  .chart-item {
    background: var(--card-bg);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    padding: 22px 24px 18px;
  }

  .chart-item h2 {
    font-family: 'Syne', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  /* ── Filters bar (sits between title/KPIs and charts) ── */
  .filters-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 16px 22px;
    margin-bottom: 24px;
  }

  /* ── Controls row ────────────────────────────── */
  .controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 8px;
  }

  .filter-dropdowns {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: flex-end;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .filter-group label,
  .filter-dropdowns > div > h3 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Select dropdown ─────────────────────────── */
  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown select {
    appearance: none;
    background: var(--card-bg);
    color: var(--ink-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 9px 36px 9px 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    min-width: 150px;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  .dropdown select:hover,
  .dropdown select:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px var(--cyan-glow);
  }

  .dropdown::after {
    content: '▾';
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--cyan);
    font-size: 0.9rem;
  }

  /* ── Trend toggles ───────────────────────────── */
  .filter-container {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }

  .filter-container > div > h3 {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .slider-container {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* Replace old toggle with pill buttons */
  .switch {
    position: relative;
    display: inline-block;
    width: auto;
    height: auto;
  }

  .switch input { display: none; }

  .switch .slider {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
    border-radius: 100px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    transition: background 0.18s, color 0.18s, border-color 0.18s;
    user-select: none;
    position: static;
    top: auto; left: auto; right: auto; bottom: auto;
  }

  .switch input:checked + .slider {
    background: var(--cyan);
    border-color: var(--cyan);
    color: #fff;
  }

  .switch .slider:hover {
    border-color: var(--cyan);
    color: var(--cyan);
  }

  .switch input:checked + .slider:hover {
    color: #fff;
  }

  /* hide the old ::before pseudo on the new pill sliders */
  .switch .slider:before { display: none; }
  .slider-text { display: none; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
