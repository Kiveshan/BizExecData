<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Extracting Financial Data" %> — Business Executive</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cyan: #00BDD6; --cyan-dark: #0099B0; --cyan-glow: rgba(0,189,214,0.10);
      --ink: #0B1120; --ink-soft: #2E3A4A; --muted: #6B7A8D;
      --surface: #F2F6FA; --card-bg: #FFFFFF; --border: rgba(0,189,214,0.18);
      --radius-lg: 18px; --radius-md: 10px; --shadow-card: 0 8px 40px rgba(11,17,32,0.12);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .loading-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-card);
      padding: 48px 44px 40px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      animation: fadeUp 0.4s ease both;
    }

    /* Spinner */
    .spinner {
      width: 52px;
      height: 52px;
      border: 4px solid var(--border);
      border-top-color: var(--cyan);
      border-radius: 50%;
      animation: spin 0.85s linear infinite;
      margin: 0 auto 28px;
    }

    .loading-card h1 {
      font-family: 'Syne', sans-serif;
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .status-message {
      font-size: 0.9rem;
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 28px;
    }

    /* Progress bar */
    .progress-wrap {
      background: rgba(0,189,214,0.10);
      border-radius: 100px;
      height: 10px;
      overflow: hidden;
      margin-bottom: 8px;
    }

    .progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--cyan) 0%, var(--cyan-dark) 100%);
      border-radius: 100px;
      transition: width 0.3s ease;
    }

    .progress-text {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 22px;
      letter-spacing: 0.04em;
    }

    /* Status pill */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      border-radius: 100px;
      font-size: 0.82rem;
      font-weight: 500;
      border: 1px solid var(--border);
      background: var(--cyan-glow);
      color: var(--ink-soft);
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }

    .status-pill.success { background: rgba(52,211,153,0.12); color: #065f46; border-color: rgba(52,211,153,0.3); }
    .status-pill.warning { background: rgba(251,191,36,0.12);  color: #78350f; border-color: rgba(251,191,36,0.3); }
    .status-pill.danger  { background: rgba(229,57,53,0.10);   color: #7f1d1d; border-color: rgba(229,57,53,0.25); }

    .status-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--cyan);
      animation: dot-pulse 1.4s infinite;
      flex-shrink: 0;
    }

    .status-pill.success .status-dot { background: #34D399; animation: none; }
    .status-pill.danger  .status-dot { background: #E53935; animation: none; }
    .status-pill.warning .status-dot { background: #FBBF24; animation: none; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes dot-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.7); } }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <div class="loading-card">
    <div class="spinner"></div>
    <h1><%= title || "Extracting Your Financial Data" %></h1>
    <p class="status-message">
      <%= description || "We're extracting your profit and loss data." %><br>
      This may take a few minutes. Please don't close this window.
    </p>

    <div class="progress-wrap">
      <div id="progress-bar" class="progress-bar"></div>
    </div>
    <div class="progress-text"><span id="progress-percentage">0%</span> complete</div>

    <div id="progress-info" class="status-pill">
      <span class="status-dot"></span>
      <span id="status-text">Starting data extraction…</span>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const source = "<%= source || 'sage' %>";

      let startEndpoint, checkEndpoint, redirectUrl;
      if (source === 'quickbooks') {
        startEndpoint = '/start-quickbooks-extraction';
        checkEndpoint = '/check-quickbooks-extraction';
        redirectUrl   = '/company';
      } else if (source === 'xero') {
        startEndpoint = '/start-xero-extraction';
        checkEndpoint = '/check-xero-extraction';
        redirectUrl   = '/xerocompany';
      } else {
        startEndpoint = '/start-profit-loss-process';
        checkEndpoint = '/check-extraction-complete';
        redirectUrl   = '/sagecompany';
      }

      const checkInterval = setInterval(checkExtractionStatus, 3000);

      async function startExtraction() {
        try {
          const response = await fetch(startEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
          const data = await response.json();
          if (data.success) {
            updateStatus('Data extraction started. This may take several minutes…');
          } else {
            updateStatus('Error starting extraction: ' + (data.error || 'Unknown error'), 'danger');
          }
        } catch (error) {
          console.error('Error starting extraction:', error);
          updateStatus('Error connecting to server. Please refresh to try again.', 'danger');
        }
      }

      async function checkExtractionStatus() {
        try {
          const response = await fetch(checkEndpoint);
          const data = await response.json();

          if (data.error) { updateStatus('Error checking status: ' + data.error, 'danger'); return; }
          if (data.progress !== undefined) updateProgressBar(data.progress);

          if (data.complete) {
            clearInterval(checkInterval);
            updateProgressBar(100);
            updateStatus('Data extraction complete! Redirecting to dashboard…', 'success');
            setTimeout(() => { window.location.href = redirectUrl; }, 2000);
          } else {
            updateStatus('Still processing your data. Please wait…');
          }
        } catch (error) {
          console.error('Error checking extraction status:', error);
          updateStatus('Error connecting to server. Still trying…', 'warning');
        }
      }

      function updateProgressBar(progress) {
        document.getElementById('progress-bar').style.width = progress + '%';
        document.getElementById('progress-percentage').textContent = progress + '%';
      }

      function updateStatus(message, type = 'info') {
        const pill = document.getElementById('progress-info');
        const text = document.getElementById('status-text');
        text.textContent = message;
        pill.className = 'status-pill' + (type !== 'info' ? ' ' + type : '');
      }

      startExtraction();
    });
  </script>
</body>
</html>
