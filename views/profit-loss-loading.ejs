<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Processing Financial Data</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 20px;
            background-color: white;
            border-bottom: 1px solid #ccc;
        }
        
        .navbar .logo {
            display: flex;
            align-items: center;
        }
        
        .navbar .logo img {
            height: 50px;
            margin-right: 10px;
        }
        
        .navbar .logo h3 {
            font-size: 18px;
            font-weight: bold;
            color: #00BDD6;
            margin: 0;
        }
        
        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .loading-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 30px;
            width: 100%;
            max-width: 600px;
            text-align: center;
        }
        
        .loading-title {
            color: #00BDD6;
            font-size: 24px;
            margin-bottom: 20px;
        }
        
        .loading-subtitle {
            color: #666;
            font-size: 16px;
            margin-bottom: 30px;
        }
        
        .progress-container {
            width: 100%;
            background-color: #f1f1f1;
            border-radius: 5px;
            margin-bottom: 20px;
        }
        
        .progress-bar {
            height: 20px;
            background-color: #00BDD6;
            border-radius: 5px;
            width: 0%;
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
            font-weight: bold;
        }
        
        .status-container {
            margin-top: 20px;
            padding: 15px;
            background-color: #f9f9f9;
            border-radius: 5px;
            max-height: 200px;
            overflow-y: auto;
            text-align: left;
        }
        
        .status-message {
            margin: 5px 0;
            padding: 5px 0;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }
        
        .status-message.success {
            color: #28a745;
        }
        
        .status-message.error {
            color: #dc3545;
        }
        
        .status-message.info {
            color: #17a2b8;
        }
        
        .loading-spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #00BDD6;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 2s linear infinite;
            margin: 0 auto 20px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .hidden {
            display: none;
        }
        
        .btn {
            padding: 10px 20px;
            background-color: #00BDD6;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
        }
        
        .btn:hover {
            background-color: #009bb0;
        }
        
        .btn:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="logo">
                <a href="/index">
                    <img src="logo_biz.png" alt="Navbar Logo">
                </a>
                <h3>Business Executive Data</h3>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="loading-card">
            <h1 class="loading-title">Processing Financial Data</h1>
            <p class="loading-subtitle">Please wait while we extract and process your Sage financial data.</p>
            
            <div class="loading-spinner" id="loadingSpinner"></div>
            
            <div class="progress-container">
                <div class="progress-bar" id="progressBar">0%</div>
            </div>
            
            <p id="currentOperation">Initializing...</p>
            
            <div class="status-container" id="statusContainer">
                <div class="status-message info">Starting data extraction process...</div>
            </div>
            
            <button id="viewDashboardBtn" class="btn hidden">View Dashboard</button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const progressBar = document.getElementById('progressBar');
            const currentOperation = document.getElementById('currentOperation');
            const statusContainer = document.getElementById('statusContainer');
            const loadingSpinner = document.getElementById('loadingSpinner');
            const viewDashboardBtn = document.getElementById('viewDashboardBtn');
            
            // Function to add a status message
            function addStatusMessage(message, type = 'info') {
                const messageElement = document.createElement('div');
                messageElement.className = `status-message ${type}`;
                messageElement.textContent = message;
                statusContainer.appendChild(messageElement);
                statusContainer.scrollTop = statusContainer.scrollHeight;
            }
            
            // Function to update progress
            function updateProgress(percent, operation) {
                progressBar.style.width = `${percent}%`;
                progressBar.textContent = `${percent}%`;
                if (operation) {
                    currentOperation.textContent = operation;
                    addStatusMessage(operation);
                }
            }
            
            // Function to complete the loading process
            function completeLoading(success = true, message = '') {
                loadingSpinner.style.display = 'none';
                viewDashboardBtn.classList.remove('hidden');
                
                if (success) {
                    updateProgress(100, 'Processing complete!');
                    addStatusMessage('All financial data has been successfully processed.', 'success');
                } else {
                    addStatusMessage(`Error: ${message}`, 'error');
                    addStatusMessage('Processing completed with errors. Some data may be incomplete.', 'error');
                }
            }
            
            // Function to check progress
            function checkProgress(progressId) {
                fetch(`/check-progress/${progressId}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data.error) {
                            completeLoading(false, data.error);
                            return;
                        }
                        
                        // Update progress bar
                        const percent = Math.round((data.processed / data.total) * 100);
                        updateProgress(percent, `Processed ${data.processed} of ${data.total} months`);
                        
                        // Add new status messages
                        if (data.newMessages && data.newMessages.length > 0) {
                            data.newMessages.forEach(msg => {
                                addStatusMessage(msg.message, msg.type);
                            });
                        }
                        
                        // If not complete, check again in 2 seconds
                        if (!data.complete) {
                            setTimeout(() => checkProgress(progressId), 2000);
                        } else {
                            completeLoading(true);
                        }
                    })
                    .catch(error => {
                        console.error('Error checking progress:', error);
                        // If there's an error, try again in 3 seconds
                        setTimeout(() => checkProgress(progressId), 3000);
                    });
            }
            
            // Start the data extraction process
            function startDataExtraction() {
                addStatusMessage('Connecting to Sage API...');
                updateProgress(5, 'Starting data extraction...');
                
                fetch('/start-profit-loss-process', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        completeLoading(false, data.error);
                        return;
                    }
                    
                    addStatusMessage(`Found ${data.totalMonths} months of data to process`, 'info');
                    
                    // Start checking progress
                    checkProgress(data.progressId);
                })
                .catch(error => {
                    console.error('Error starting process:', error);
                    completeLoading(false, 'Failed to start data extraction process');
                });
            }
            
            // Handle dashboard button click
            viewDashboardBtn.addEventListener('click', function() {
                window.location.href = '/sagecompany';
            });
            
            // Start the process automatically when the page loads
            setTimeout(startDataExtraction, 1000); // Small delay for better UX
        });
    </script>
</body>
</html>