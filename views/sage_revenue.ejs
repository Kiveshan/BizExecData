<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Revenue — Sage</title>
  <link rel="stylesheet" href="style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cyan: #00BDD6; --cyan-dark: #0099B0; --cyan-glow: rgba(0,189,214,0.10);
      --ink: #0B1120; --ink-soft: #2E3A4A; --muted: #6B7A8D;
      --surface: #F2F6FA; --card-bg: #FFFFFF; --border: rgba(0,189,214,0.18);
      --radius-lg: 16px; --radius-md: 10px; --shadow-card: 0 4px 20px rgba(11,17,32,0.07);
    }
    body { font-family: 'DM Sans', sans-serif; background: var(--surface); color: var(--ink-soft); min-height: 100vh; }
    .main-content { margin-left: 230px; padding: 28px 32px 80px; transition: margin-left 0.25s ease; animation: fadeUp 0.45s ease both; }
    body.sidebar-collapsed .main-content { margin-left: 56px; }
    .main-content > h1 { font-family: 'Syne', sans-serif; font-size: 1.5rem; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; margin-bottom: 24px; }
    .filters-bar { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 24px; background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); padding: 16px 22px; margin-bottom: 24px; }
    .filter-dropdowns { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; }
    .filter-dropdowns > div > h3, .filter-container > div > h3 { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .dropdown { position: relative; display: inline-block; }
    .dropdown select { appearance: none; background: var(--card-bg); color: var(--ink-soft); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 9px 36px 9px 14px; font-family: 'DM Sans', sans-serif; font-size: 0.85rem; font-weight: 500; cursor: pointer; min-width: 150px; transition: border-color 0.18s, box-shadow 0.18s; }
    .dropdown select:hover, .dropdown select:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px var(--cyan-glow); }
    .dropdown::after { content: '▾'; position: absolute; top: 50%; right: 12px; transform: translateY(-50%); pointer-events: none; color: var(--cyan); font-size: 0.9rem; }
    .filter-container { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
    .slider-container { display: flex; gap: 10px; flex-wrap: wrap; }
    .switch { position: relative; display: inline-block; width: auto; height: auto; }
    .switch input { display: none; }
    .switch .slider { display: inline-flex; align-items: center; justify-content: center; padding: 8px 20px; border-radius: 100px; background: var(--card-bg); border: 1px solid var(--border); cursor: pointer; font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--muted); transition: background 0.18s, color 0.18s, border-color 0.18s; user-select: none; position: static; }
    .switch input:checked + .slider { background: var(--cyan); border-color: var(--cyan); color: #fff; }
    .switch .slider:hover { border-color: var(--cyan); color: var(--cyan); }
    .switch input:checked + .slider:hover { color: #fff; }
    .switch .slider:before { display: none; }
    .slider-text { display: none; }
    .chart-container { display: flex; flex-direction: column; gap: 24px; margin-bottom: 28px; }
    .chart-item { background: var(--card-bg); border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-card); padding: 22px 24px 18px; }
    .chart-item h2 { font-family: 'Syne', sans-serif; font-size: 0.85rem; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <%- include("partials/sage_navbar") %>
  <%- include("partials/sage_sidebar") %>

  <div class="main-content">
  
    <!-- Filters -->
    <div class="filters-bar">
      <div class="filter-dropdowns">
        <div>
          <h3>Year</h3>
          <div class="dropdown">
            <select id="yearSelect" class="dropdown-select"><option value="">All years</option></select>
          </div>
        </div>
        <div>
          <h3>Month</h3>
          <div class="dropdown">
            <select id="monthSelect" class="dropdown-select"><option value="">All months</option></select>
          </div>
        </div>
      </div>
      <div class="filter-container">
        <div>
          <h3>Trends</h3>
          <div class="slider-container">
            <label class="switch"><input type="checkbox" id="sixMonthsToggle" checked><span class="slider">6 Months</span></label>
            <label class="switch"><input type="checkbox" id="threeMonthsToggle"><span class="slider">3 Months</span></label>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts stacked -->
    <div class="chart-container">
      <div class="chart-item">
        <h2>Revenue vs Cost of Sales per Month</h2>
        <canvas id="financialChart"></canvas>
      </div>
      <div class="chart-item">
        <h2>Revenue by Category</h2>
        <canvas id="salesChart"></canvas>
      </div>
      <div class="chart-item">
        <h2>Cost of Sales Detail</h2>
        <canvas id="costofsalesChart"></canvas>
      </div>
    </div>
  </div>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    let salesData = [], grossData = [], costofsalesData = [];
    let salesChart, financialChart, costofsalesChart;

    function formatMonth(ds)     { return new Date(ds).toLocaleString('default', { month: 'long' }); }
    function formatYear(ds)      { return new Date(ds).getFullYear().toString(); }
    function formatMonthYear(ds) { const d = new Date(ds); return `${d.toLocaleString('default', { month: 'long' })} ${d.getFullYear()}`; }
    function formatFullDate(ds)  { const d = new Date(ds); return `${d.getDate()} ${d.toLocaleString('default', { month: 'long' })} ${d.getFullYear()}`; }

    function populateYearSelect(years, lastYear) {
      const sel = document.getElementById('yearSelect');
      sel.innerHTML = '<option value="">All years</option>';
      Array.from(new Set(years)).forEach(y => { const o = document.createElement('option'); o.value = y; o.textContent = y; sel.appendChild(o); });
      sel.addEventListener('change', updateCharts); sel.value = lastYear;
    }

    function populateMonthSelect(labels, lastMonth) {
      const sel = document.getElementById('monthSelect');
      sel.innerHTML = '<option value="">All months</option>';
      Array.from(new Set(labels)).forEach(l => { const o = document.createElement('option'); o.value = l; o.textContent = l; sel.appendChild(o); });
      sel.addEventListener('change', updateCharts); sel.value = lastMonth;
    }

    function getSelectedMonths() { const v = document.getElementById('monthSelect').value; return v ? [v] : []; }
    function getSelectedYears()  { const v = document.getElementById('yearSelect').value;  return v ? [v] : []; }

    function filterData(sm, sy, data) {
      return data.filter(row => {
        const rm = formatMonth(row.date), ry = formatYear(row.date);
        if (!sm.length && !sy.length) return true;
        if (!sm.length) return sy.includes(ry);
        if (!sy.length) return sm.includes(rm);
        return sm.includes(rm) && sy.includes(ry);
      });
    }

    function updateCharts() {
      const sm = getSelectedMonths(), sy = getSelectedYears();
      updatesalesChart(filterData(sm, sy, salesData));
      updateFinancialChart(filterData(sm, sy, grossData));
      updateCostofSalesChart(filterData(sm, sy, costofsalesData));
      if (sm.length || sy.length) { document.getElementById('sixMonthsToggle').checked = false; document.getElementById('threeMonthsToggle').checked = false; }
    }

    function updatesalesChart(d) {
      salesChart.data.labels = d.map(r => r.category);
      salesChart.data.datasets[0].data = d.map(r => parseFloat(r.revenue.replace(/R|\s/g,'').replace(',','.')));
      salesChart.update();
    }
    function updateFinancialChart(d) {
      financialChart.data.labels = d.map(r => formatMonthYear(r.date));
      financialChart.data.datasets[0].data = d.map(r => parseFloat(r.sumofsales.replace(/R|\s/g,'').replace(',','.')));
      financialChart.data.datasets[1].data = d.map(r => parseFloat(r.sumofcost.replace(/R|\s/g,'').replace(',','.')));
      financialChart.update();
    }
    function updateCostofSalesChart(d) {
      costofsalesChart.data.labels = d.map(r => formatFullDate(r.date));
      costofsalesChart.data.datasets[0].data = d.map(r => parseFloat(r.costofsales.replace(/R|\s/g,'').replace(',','.')));
      costofsalesChart.update();
    }

    function getLast6MonthsData(data) { const ago = new Date(); ago.setMonth(ago.getMonth()-6); return data.filter(r => new Date(r.date) >= ago); }
    function getLast3MonthsData(data) { const ago = new Date(); ago.setMonth(ago.getMonth()-3); return data.filter(r => new Date(r.date) >= ago); }

    const chartDefaults = {
      responsive: true,
      plugins: { legend: { labels: { font: { family: 'DM Sans', size: 12 }, color: '#2E3A4A' } } },
      scales: {
        x: { grid: { color: 'rgba(0,189,214,0.07)' }, ticks: { font: { family: 'DM Sans', size: 11 }, color: '#6B7A8D' } },
        y: { beginAtZero: true, grid: { color: 'rgba(0,189,214,0.07)' }, ticks: { font: { family: 'DM Sans', size: 11 }, color: '#6B7A8D' } }
      }
    };

    function initializeCharts(grossData, salesData, costofsalesData) {
      financialChart = new Chart(document.getElementById('financialChart').getContext('2d'), {
        type: 'bar',
        data: {
          labels: grossData.map(r => formatMonthYear(r.date)),
          datasets: [
            { label: 'Sales',         data: grossData.map(r => parseFloat(r.sumofsales.replace(/R|\s/g,'').replace(',','.'))), borderColor: '#00BDD6', backgroundColor: 'rgba(0,189,214,0.75)',   borderWidth: 1 },
            { label: 'Cost of Sales', data: grossData.map(r => parseFloat(r.sumofcost.replace(/R|\s/g,'').replace(',','.'))),  borderColor: '#F97066', backgroundColor: 'rgba(249,112,102,0.75)', borderWidth: 1 }
          ]
        },
        options: chartDefaults
      });

      salesChart = new Chart(document.getElementById('salesChart').getContext('2d'), {
        type: 'bar',
        data: {
          labels: salesData.map(r => r.category),
          datasets: [{ label: 'Revenue', data: salesData.map(r => parseFloat(r.revenue.replace(/R|\s/g,'').replace(',','.'))), borderColor: '#A78BFA', backgroundColor: 'rgba(167,139,250,0.75)', borderWidth: 1 }]
        },
        options: chartDefaults
      });

      costofsalesChart = new Chart(document.getElementById('costofsalesChart').getContext('2d'), {
        type: 'bar',
        data: {
          labels: costofsalesData.map(r => formatFullDate(r.date)),
          datasets: [{ label: 'Cost of Revenue', data: costofsalesData.map(r => parseFloat(r.costofsales.replace(/R|\s/g,'').replace(',','.'))), borderColor: '#FBBF24', backgroundColor: 'rgba(251,191,36,0.75)', borderWidth: 1 }]
        },
        options: chartDefaults
      });
    }

    function fetchDefaultMonthYear() {
      Promise.all([
        fetch('/api/sagerevenue').then(r => r.json()),
        fetch('/api/sagecompany').then(r => r.json()),
        fetch('/api/sagecostofsales').then(r => r.json())
      ])
      .then(([revenueData, companyData, costOfSalesData]) => {
        salesData       = revenueData;
        grossData       = companyData.data;
        costofsalesData = costOfSalesData;
        const lastEntryDate = companyData.lastEntryDate;
        populateMonthSelect(grossData.map(r => formatMonth(r.date)), formatMonth(lastEntryDate));
        populateYearSelect(grossData.map(r => formatYear(r.date)),   formatYear(lastEntryDate));
        initializeCharts(grossData, salesData, costofsalesData);
        updateCharts();
      })
      .catch(err => console.error('Error fetching data:', err));
    }

    document.getElementById('sixMonthsToggle').addEventListener('change', function() {
      if (this.checked) { document.getElementById('threeMonthsToggle').checked = false; document.getElementById('yearSelect').value = ''; document.getElementById('monthSelect').value = '';
        updateFinancialChart(getLast6MonthsData(grossData)); updatesalesChart(getLast6MonthsData(salesData)); updateCostofSalesChart(getLast6MonthsData(costofsalesData)); }
    });
    document.getElementById('threeMonthsToggle').addEventListener('change', function() {
      if (this.checked) { document.getElementById('sixMonthsToggle').checked = false; document.getElementById('yearSelect').value = ''; document.getElementById('monthSelect').value = '';
        updateFinancialChart(getLast3MonthsData(grossData)); updatesalesChart(getLast3MonthsData(salesData)); updateCostofSalesChart(getLast3MonthsData(costofsalesData)); }
    });

    fetchDefaultMonthYear();
  });
  </script>
</body>
</html>
