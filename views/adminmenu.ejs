<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cyan:        #00BDD6;
      --cyan-dark:   #0099B0;
      --cyan-glow:   rgba(0,189,214,0.12);
      --ink:         #0B1120;
      --ink-soft:    #2E3A4A;
      --muted:       #6B7A8D;
      --surface:     #F2F6FA;
      --card-bg:     #FFFFFF;
      --border:      rgba(0,189,214,0.18);
      --danger:      #E53935;
      --danger-dark: #B71C1C;
      --radius-lg:   18px;
      --radius-md:   10px;
      --shadow-sm:   0 2px 10px rgba(11,17,32,0.06);
      --shadow-card: 0 4px 24px rgba(11,17,32,0.08);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      color: var(--ink-soft);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ─────────────────────────────────── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 36px;
      height: 68px;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .header .logo img {
      height: 40px;
      width: auto;
    }

    .header .logo-text .brand {
      display: block;
      font-family: 'Syne', sans-serif;
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: -0.02em;
      line-height: 1;
    }

    .header .logo-text .sub {
      display: block;
      font-size: 0.62rem;
      font-weight: 400;
      color: var(--muted);
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .header-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--ink);
      letter-spacing: -0.01em;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border-radius: var(--radius-md);
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.83rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.18s, transform 0.12s;
    }

    .btn:hover { transform: translateY(-1px); }

    .btn-back {
      background: var(--cyan-glow);
      color: var(--cyan-dark);
      border: 1px solid var(--border);
    }

    .btn-back:hover { background: rgba(0,189,214,0.22); }

    .btn-logout {
      background: var(--danger);
      color: #fff;
    }

    .btn-logout:hover { background: var(--danger-dark); }

    /* ── Main Content ───────────────────────────── */
    .content {
      flex: 1;
      padding: 36px 40px 80px;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      animation: fadeUp 0.5s ease both;
    }

    /* ── Admin Tiles ────────────────────────────── */
    .tiles {
      display: grid;
      grid-template-columns: repeat(2, 340px);
      gap: 30px;
      padding: 60px 40px 80px;
      justify-content: center;
      animation: fadeUp 0.5s 0.1s ease both;
    }

    .tile {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-card);
      padding: 44px 32px 36px;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
      position: relative;
      overflow: hidden;
      transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .tile::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--radius-lg);
      background: linear-gradient(140deg, var(--cyan-glow) 0%, transparent 55%);
      opacity: 0;
      transition: opacity 0.25s;
    }

    .tile:hover {
      transform: translateY(-6px);
      box-shadow: 0 16px 40px rgba(0,189,214,0.15);
      border-color: rgba(0,189,214,0.4);
    }

    .tile:hover::after { opacity: 1; }

    .tile-img-wrap {
      width: 100%;
      height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
    }

    .tile-img-wrap img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .tile-label {
      font-family: 'Syne', sans-serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--ink);
      position: relative;
      z-index: 1;
    }

    .tile-cta {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--cyan);
      position: relative;
      z-index: 1;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.18s, transform 0.18s;
    }

    .tile:hover .tile-cta { opacity: 1; transform: translateY(0); }

    /* ── Notification Badge ─────────────────────── */
    .notification-badge {
      position: absolute;
      top: 14px;
      right: 14px;
      background: var(--danger);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 700;
      border-radius: 100px;
      padding: 3px 8px;
      z-index: 2;
    }

    /* ── Footer ─────────────────────────────────── */
    .footer {
      background: var(--cyan);
      color: #fff;
      text-align: center;
      position: fixed;
      bottom: 0; left: 0;
      width: 100%;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 500;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="logo">
      <img src="logo_biz.png" alt="Business Executive Logo">
      <div class="logo-text">
        <span class="brand">Business Executive</span>
        <span class="sub">Admin Portal</span>
      </div>
    </div>
    <span class="header-title">Admin Menu</span>
    <div class="header-actions">
      <form action="/logout?_method=DELETE" method="POST">
        <button class="btn btn-logout" type="submit">Logout</button>
      </form>
    </div>
  </div>

  <div class="tiles">
    <a href="companyregapplications">
      <div class="tile">
        <span class="notification-badge">2</span>
        <div class="tile-img-wrap">
          <img src="/company_approval.jpg" alt="Company Approval">
        </div>
        <span class="tile-label">Company Approval</span>
        <span class="tile-cta">Manage applications &rarr;</span>
      </div>
    </a>

    <a href="licensemgt">
      <div class="tile">
        <div class="tile-img-wrap">
          <img src="/license_agreement.jpg" alt="License Management">
        </div>
        <span class="tile-label">License Management</span>
        <span class="tile-cta">View licences &rarr;</span>
      </div>
    </a>
  </div>

  <div class="footer">© Business Executive</div>

</body>
</html>
