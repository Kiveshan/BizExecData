<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --cyan:        #00BDD6;
            --cyan-dark:   #0099B0;
            --cyan-glow:   rgba(0, 189, 214, 0.12);
            --ink:         #0B1120;
            --ink-soft:    #2E3A4A;
            --muted:       #6B7A8D;
            --surface:     #F2F6FA;
            --card-bg:     #FFFFFF;
            --border:      rgba(0, 189, 214, 0.18);
            --radius-lg:   18px;
            --radius-md:   12px;
            --shadow-card: 0 4px 24px rgba(11,17,32,0.08);
        }

        body {
            background-color: var(--surface);
            font-family: 'DM Sans', sans-serif;
            color: var(--ink-soft);
            overflow-x: hidden;
            min-height: 100vh;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 40px;
            height: 72px;
            background: #fff;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 2px 10px rgba(11,17,32,0.06);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar .logo {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
        }

        .navbar .logo img {
            height: 44px;
            width: auto;
        }

        .navbar .logo-text {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

        .navbar .logo-text .brand {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--cyan);
            letter-spacing: -0.02em;
            line-height: 1;
        }

        .navbar .logo-text .tagline {
            font-size: 0.65rem;
            font-weight: 400;
            color: var(--muted);
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        .navbar .nav-links {
            list-style: none;
            display: flex;
            gap: 10px;
        }

        .navbar .nav-links li a {
            text-decoration: none;
            color: #fff;
            font-weight: 600;
            font-size: 0.85rem;
            padding: 9px 22px;
            background-color: var(--cyan);
            border-radius: 9px;
            letter-spacing: 0.01em;
            transition: background-color 0.2s, transform 0.15s;
            display: inline-block;
        }

        .navbar .nav-links li a:hover {
            background-color: var(--cyan-dark);
            transform: translateY(-1px);
        }

        .form-container {
            min-height: calc(100vh - 72px);
            display: grid;
            place-items: center;
            padding: 46px 18px 70px;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            padding: 28px 24px 22px;
        }

        .auth-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: -0.02em;
            text-align: center;
            margin-bottom: 10px;
        }

        .auth-subtitle {
            text-align: center;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.6;
            margin-bottom: 18px;
        }

        .form-field {
            width: 100%;
            padding: 12px 14px;
            margin: 10px 0;
            border: 1px solid rgba(11,17,32,0.14);
            border-radius: 12px;
            font-size: 0.95rem;
            color: var(--ink-soft);
            background: #fff;
            outline: none;
            transition: box-shadow 0.2s, border-color 0.2s;
        }

        .form-field:focus {
            border-color: rgba(0, 189, 214, 0.65);
            box-shadow: 0 0 0 4px var(--cyan-glow);
        }

        .primary-btn {
            width: 100%;
            padding: 12px;
            margin-top: 14px;
            background-color: var(--cyan);
            border: none;
            border-radius: 12px;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.15s;
        }

        .primary-btn:hover {
            background-color: var(--cyan-dark);
            transform: translateY(-1px);
        }

        .auth-footer {
            text-align: center;
            margin-top: 16px;
            font-size: 0.9rem;
            color: var(--muted);
        }

        .auth-footer a {
            color: var(--cyan);
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer a:hover {
            text-decoration: underline;
        }

        .error-message {
            background: rgba(244, 67, 54, 0.12);
            border: 1px solid rgba(244, 67, 54, 0.28);
            color: #b42318;
            border-radius: var(--radius-md);
            padding: 10px 12px;
            text-align: center;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }

        @media (max-width: 640px) {
            .navbar { padding: 0 20px; }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar">
            <a class="logo" href="/index">
                <img src="logo_biz.png" alt="Business Executive Logo">
                <div class="logo-text">
                    <span class="brand">Business Executive</span>
                    <span class="tagline">Accurate Analytics &middot; Live Dashboards</span>
                </div>
            </a>
            <ul class="nav-links">
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
            </ul>
        </nav>
    </header>

    <div class="form-container">
        <form class="auth-card" action="/login" method="post">
            <h1 class="auth-title">Login to your account</h1>
            <h2 class="auth-subtitle">Enter your credentials to access your account</h2>

            <% if (typeof error !== 'undefined') { %>
                <div class="error-message">
                    <%= error %>
                </div>
            <% } %>

            <input class="form-field" type="email" name="email" placeholder="Email" required>
            <input class="form-field" type="password" name="password" placeholder="Password" required>
            <button class="primary-btn" type="submit">Login</button>
            <p class="auth-footer">Don't have an account? <a href="/register">Register</a></p>
        </form>
    </div>
</body>
</html>
