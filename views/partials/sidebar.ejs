<style>
  /* ── Sidebar shell ───────────────────────────────────────── */
  .sidebar {
    position: fixed;
    top: 72px;           /* sits below the navbar */
    left: 0;
    height: calc(100vh - 72px);
    width: 230px;
    background: #fff;
    border-right: 1px solid rgba(0,189,214,0.18);
    box-shadow: 2px 0 12px rgba(11,17,32,0.06);
    display: flex;
    flex-direction: column;
    z-index: 900;
    transition: width 0.25s ease;
    overflow: hidden;
  }

  .sidebar.collapsed {
    width: 56px;
  }

  /* ── Toggle button ───────────────────────────────────────── */
  .sidebar-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(0,189,214,0.12);
    flex-shrink: 0;
  }

  .sidebar-toggle button {
    background: rgba(0,189,214,0.10);
    border: 1px solid rgba(0,189,214,0.18);
    border-radius: 8px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #0099B0;
    font-size: 1rem;
    transition: background 0.18s;
    flex-shrink: 0;
  }

  .sidebar-toggle button:hover {
    background: rgba(0,189,214,0.22);
  }

  /* ── Section label ───────────────────────────────────────── */
  .sidebar-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B7A8D;
    padding: 18px 18px 8px;
    white-space: nowrap;
    overflow: hidden;
    opacity: 1;
    transition: opacity 0.18s;
  }

  .sidebar.collapsed .sidebar-label {
    opacity: 0;
  }

  /* ── Nav buttons ─────────────────────────────────────────── */
  .button-container {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 4px 10px;
    flex: 1;
    overflow-y: auto;
  }

  .button {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 10px;
    border: none;
    border-radius: 10px;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #2E3A4A;
    cursor: pointer;
    text-align: left;
    white-space: nowrap;
    transition: background 0.18s, color 0.18s;
    position: relative;
  }

  .button:hover {
    background: rgba(0,189,214,0.08);
    color: #0099B0;
  }

  .button.active {
    background: rgba(0,189,214,0.12);
    color: #0099B0;
    font-weight: 600;
  }

  .button.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    height: 60%;
    width: 3px;
    background: #00BDD6;
    border-radius: 0 3px 3px 0;
  }

  /* ── Button icons ────────────────────────────────────────── */
  .btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
  }

  .btn-label {
    overflow: hidden;
    white-space: nowrap;
    transition: opacity 0.18s, max-width 0.25s;
    max-width: 160px;
    opacity: 1;
  }

  .sidebar.collapsed .btn-label {
    opacity: 0;
    max-width: 0;
  }

  /* ── Tooltip on collapsed icons ─────────────────────────── */
  .sidebar.collapsed .button {
    justify-content: center;
    padding: 10px;
  }

  .button[data-tooltip] {
    position: relative;
  }

  .sidebar.collapsed .button[data-tooltip]:hover::after {
    content: attr(data-tooltip);
    position: absolute;
    left: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    background: #0B1120;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 7px;
    white-space: nowrap;
    z-index: 999;
    pointer-events: none;
    box-shadow: 0 4px 12px rgba(11,17,32,0.15);
  }

  /* ── Adjust main content when sidebar expands/collapses ─── */
  .main-content {
    margin-left: 230px;
    transition: margin-left 0.25s ease;
  }

  .sidebar.collapsed ~ * .main-content,
  body.sidebar-collapsed .main-content {
    margin-left: 56px;
  }

  /* footer shift */
  .footer {
    left: 230px;
    width: calc(100% - 230px);
    transition: left 0.25s ease, width 0.25s ease;
  }

  body.sidebar-collapsed .footer {
    left: 56px;
    width: calc(100% - 56px);
  }
</style>

<div class="sidebar" id="appSidebar">

  <!-- Toggle -->
  <div class="sidebar-toggle">
    <button id="sidebarToggleBtn" aria-label="Toggle sidebar">
      &#x276E;
    </button>
  </div>

  <!-- Nav -->
  <div class="button-container">

    <button class="button" data-href="/company" data-tooltip="Business Overview">
      <span class="btn-label">Business Overview</span>
    </button>

    <button class="button" data-href="/revenue" data-tooltip="Revenue &amp; Cost">
      <span class="btn-label">Revenue &amp; Cost</span>
    </button>

    <button class="button" data-href="/expenses" data-tooltip="Expenses">
      <span class="btn-label">Expenses</span>
    </button>

  </div>
</div>

<script>
  (function () {
    const sidebar  = document.getElementById('appSidebar');
    const toggleBtn = document.getElementById('sidebarToggleBtn');

    // ── Collapse state ──────────────────────────────────────
    const STORAGE_KEY = 'sidebarCollapsed';
    let collapsed = localStorage.getItem(STORAGE_KEY) === 'true';

    function applyState() {
      if (collapsed) {
        sidebar.classList.add('collapsed');
        document.body.classList.add('sidebar-collapsed');
        toggleBtn.innerHTML = '&#x276F;';  // › point right = expand
      } else {
        sidebar.classList.remove('collapsed');
        document.body.classList.remove('sidebar-collapsed');
        toggleBtn.innerHTML = '&#x276E;';  // ‹ point left = collapse
      }
    }

    toggleBtn.addEventListener('click', function () {
      collapsed = !collapsed;
      localStorage.setItem(STORAGE_KEY, collapsed);
      applyState();
    });

    applyState();

    // ── Active highlight ────────────────────────────────────
    const currentPath = window.location.pathname;

    document.querySelectorAll('.button[data-href]').forEach(function (btn) {
      const href = btn.getAttribute('data-href');
      // match exact path or sub-paths (e.g. /company/details still highlights /company)
      if (currentPath === href || currentPath.startsWith(href + '/')) {
        btn.classList.add('active');
      }

      btn.addEventListener('click', function () {
        document.querySelectorAll('.button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const dest = btn.getAttribute('data-href');
        if (dest) window.location.href = dest;
      });
    });
  })();
</script>
