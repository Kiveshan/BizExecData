<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">

<style>
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
    height: 72px;
    background: #fff;
    border-bottom: 1px solid rgba(0,189,214,0.18);
    box-shadow: 0 2px 10px rgba(11,17,32,0.06);
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    box-sizing: border-box;
  }

  /* Logo */
  .logo-container {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .logo {
    height: 44px;
    width: auto;
  }

  .navbar-brand {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .navbar-brand .brand-name {
    font-family: 'Syne', sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    color: #00BDD6;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .navbar-brand .brand-tagline {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.65rem;
    font-weight: 400;
    color: #6B7A8D;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Nav buttons */
  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .update-dashboard-button,
  .logout-button {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border-radius: 9px;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
    margin-top: 0;
  }

  .update-dashboard-button {
    background-color: #00BDD6;
    color: #fff;
  }

  .update-dashboard-button:hover {
    background-color: #0099B0;
    transform: translateY(-1px);
  }

  .logout-button {
    background-color: #E53935;
    color: #fff;
  }

  .logout-button:hover {
    background-color: #B71C1C;
    transform: translateY(-1px);
  }

  /* Push page content below fixed navbar */
  body {
    padding-top: 72px;
  }
</style>

<div class="navbar">
  <div class="logo-container">
    <img src="logo_biz.png" alt="Business Executive Logo" class="logo">
    <div class="navbar-brand">
      <span class="brand-name">Business Executive</span>
      <span class="brand-tagline">Accurate Analytics &middot; Live Dashboards</span>
    </div>
  </div>

  <div class="nav-buttons">
    <form action="/update_xerodashboard" method="GET" class="update-dashboard-form">
      <button class="update-dashboard-button" type="submit">Update Dashboard</button>
    </form>

    <form action="/logout?_method=DELETE" method="POST" class="logout-form">
      <button class="logout-button" type="submit">Logout</button>
    </form>
  </div>
</div>
