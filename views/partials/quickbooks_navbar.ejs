/* Navbar styles with horizontal content */
<style>

.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 60px; /* Adjust the height of your navbar */
  background: #FFFFFFFF;
  border-radius: 0px;
  box-shadow: 0px 0px 1.5px #171a1f, 0px 0px 2px #171a1f;
  color: white;
  z-index: 1000;
  display: flex;
  justify-content: space-between; /* Spread items horizontally */
  align-items: center;
  padding: 0 20px;
  box-sizing: border-box;
}

/* Logo */
.logo-container {
  height: 100%; /* Take the full height of the navbar */
}

.logo {
  max-height: 100%; /* Ensure the logo fits within the navbar */
  width: auto; /* Maintain aspect ratio */
}

/* Container for the buttons */
.nav-buttons {
  display: flex;
  gap: 10px; /* Add space between the buttons */
}

/* Styling for the Update Dashboard button */
.update-dashboard-button {
  background-color: blue;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  font-family: Epilogue;
}

.update-dashboard-button:hover {
  background-color: #0056b3; /* Darker blue on hover */
}

/* Styling for the Logout button */
.logout-button {
  background-color: red;
  color: white;
  border: none;
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  font-family: Epilogue;
}

.logout-button:hover {
  background-color: #b30000; /* Darker red on hover */
}

/* Styling for navbar links (if applicable) */
.navbar ul {
  list-style: none;
  display: flex;
  margin: 0;
  padding: 0;
}

.navbar ul li {
  margin-right: 20px; /* Space between items */
  font-family: Epilogue;
}

.navbar ul li a {
  font-family: Epilogue;
  font-size: 20px;
  line-height: 22px;
  font-weight: 700;
  color: #00BDD6FF;
  text-decoration: none;
}

.navbar ul li a:hover {
  text-decoration: underline;
}

</style>

<div class="navbar">
  <div class="logo-container">
    <img src="logo_biz.png" alt="Logo" class="logo">
  </div>

  <div class="nav-buttons">
    <form action="/quickbooks-loading" method="GET" class="update-dashboard-form">
      <button class="update-dashboard-button" type="submit" style="background-color: blue; margin-top: 20px;">Update Dashboard</button>
    </form>

    <form action="/logout?_method=DELETE" method="POST" class="logout-form">
      <button class="logout-button" type="submit" style="background-color: red; margin-top: 20px;">Logout</button>
    </form>
  </div>
</div>
