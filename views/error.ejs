<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error <%= statusCode %> — Business Executive</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cyan: #00BDD6; --cyan-dark: #0099B0; --cyan-glow: rgba(0,189,214,0.10);
      --ink: #0B1120; --ink-soft: #2E3A4A; --muted: #6B7A8D;
      --surface: #F2F6FA; --card-bg: #FFFFFF; --border: rgba(0,189,214,0.18);
      --danger: #E53935; --radius-lg: 18px; --radius-md: 10px;
      --shadow-card: 0 8px 40px rgba(11,17,32,0.12);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }

    .error-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-card);
      padding: 52px 44px 44px;
      max-width: 480px;
      width: 100%;
      text-align: center;
      animation: fadeUp 0.4s ease both;
    }

    .error-code {
      font-family: 'Syne', sans-serif;
      font-size: 5rem;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: -0.04em;
      line-height: 1;
      margin-bottom: 16px;
    }

    .error-divider {
      width: 48px;
      height: 3px;
      background: var(--cyan);
      border-radius: 2px;
      margin: 0 auto 22px;
    }

    .error-message {
      font-size: 1rem;
      color: var(--ink-soft);
      line-height: 1.7;
      margin-bottom: 36px;
    }

    .error-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
    }

    a {
      display: inline-flex;
      align-items: center;
      padding: 10px 24px;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.88rem;
      font-weight: 600;
      transition: background 0.18s, transform 0.12s;
    }

    a:hover { transform: translateY(-1px); }

    .btn-primary { background: var(--cyan); color: #fff; }
    .btn-primary:hover { background: var(--cyan-dark); }

    .btn-secondary { background: var(--surface); color: var(--ink-soft); border: 1px solid var(--border); }
    .btn-secondary:hover { background: #e4eaf0; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <div class="error-card">
    <div class="error-code"><%= statusCode %></div>
    <div class="error-divider"></div>
    <div class="error-message"><%= message %></div>
    <div class="error-actions">
      <a href="/" class="btn-primary">Go Home</a>
      <a href="javascript:history.back()" class="btn-secondary">Go Back</a>
    </div>
  </div>
</body>
</html>
