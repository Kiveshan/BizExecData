<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>License Management</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./style.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cyan:        #00BDD6;
      --cyan-dark:   #0099B0;
      --cyan-glow:   rgba(0,189,214,0.10);
      --ink:         #0B1120;
      --ink-soft:    #2E3A4A;
      --muted:       #6B7A8D;
      --surface:     #F2F6FA;
      --card-bg:     #FFFFFF;
      --border:      rgba(0,189,214,0.18);
      --danger:      #E53935;
      --danger-dark: #B71C1C;
      --radius-lg:   16px;
      --radius-md:   10px;
      --shadow-sm:   0 2px 10px rgba(11,17,32,0.06);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      color: var(--ink-soft);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ─────────────────────────────────── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 36px;
      height: 64px;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--ink);
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .header-actions { display: flex; gap: 10px; align-items: center; }

    .btn {
      display: inline-flex;
      align-items: center;
      padding: 8px 18px;
      border-radius: var(--radius-md);
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.18s, transform 0.12s;
    }

    .btn:hover { transform: translateY(-1px); }
    .btn-back  { background: var(--cyan-glow); color: var(--cyan-dark); border: 1px solid var(--border); }
    .btn-back:hover { background: rgba(0,189,214,0.20); }
    .btn-logout { background: var(--danger); color: #fff; }
    .btn-logout:hover { background: var(--danger-dark); }

    /* ── Layout ─────────────────────────────────── */
    .page-body {
      flex: 1;
      padding: 32px 36px 80px;
      animation: fadeUp 0.45s ease both;
    }

    /* ── Table Card ─────────────────────────────── */
    .table-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: 0 4px 20px rgba(11,17,32,0.07);
      overflow: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 720px;
    }

    thead tr { background: var(--cyan); }

    thead th {
      padding: 13px 16px;
      text-align: left;
      font-size: 0.72rem;
      font-weight: 600;
      color: #fff;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid rgba(0,189,214,0.09);
      transition: background 0.15s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:nth-child(even) { background: rgba(242,246,250,0.7); }
    tbody tr:hover { background: var(--cyan-glow); }

    tbody td {
      padding: 11px 16px;
      font-size: 0.84rem;
      color: var(--ink-soft);
      vertical-align: middle;
    }

    /* ── Status Pill ────────────────────────────── */
    .status-pill {
      display: inline-flex;
      padding: 3px 10px;
      border-radius: 100px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: capitalize;
    }

    .status-pill.active   { background: rgba(0,189,100,0.12); color: #1B5E20; }
    .status-pill.expired  { background: rgba(229,57,53,0.12);  color: var(--danger); }
    .status-pill.pending  { background: rgba(255,160,0,0.12);  color: #E65100; }
    .status-pill.inactive { background: rgba(107,122,141,0.12);color: var(--muted); }
    .status-pill.default  { background: var(--cyan-glow); color: var(--cyan-dark); }

    /* ── Action Buttons (table) ─────────────────── */
    .action-btn {
      display: inline-flex;
      align-items: center;
      padding: 5px 14px;
      border-radius: 7px;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s;
      white-space: nowrap;
    }

    .action-btn:hover { transform: translateY(-1px); }
    .action-btn.renew { background: var(--cyan); color: #fff; }
    .action-btn.renew:hover { background: var(--cyan-dark); }
    .action-btn.deactivate { background: rgba(229,57,53,0.10); color: var(--danger); border: 1px solid rgba(229,57,53,0.22); }
    .action-btn.deactivate:hover { background: rgba(229,57,53,0.20); }



    /* ── Footer ─────────────────────────────────── */
    .footer {
      background: var(--cyan);
      color: #fff;
      text-align: center;
      position: fixed;
      bottom: 0; left: 0;
      width: 100%;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 500;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <div class="header">
    <a href="/adminmenu" class="btn btn-back">← Back</a>
    <span class="header-title">License Management</span>
    <div class="header-actions">
      <form action="/logout?_method=DELETE" method="POST">
        <button class="btn btn-logout" type="submit">Logout</button>
      </form>
    </div>
  </div>

  <div class="page-body">

    <!-- ── Main Table ── -->
    <div class="table-card">
      <table>
        <thead>
          <tr>
            <th>App ID</th>
            <th>Owner</th>
            <th>Company</th>
            <th>Date Submitted</th>
            <th>Status</th>
            <th>Valid Until</th>
            <th colspan="2">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% licenses.forEach(license => { %>
          <tr>
            <td><%= license.licenseid %></td>
            <td><%= license.owner_name %></td>
            <td><%= license.company_name %></td>

            <% if (license.date_submitted) { %>
              <td><%= new Date(license.date_submitted).toISOString().slice(0,10).replace(/-/g,'/') %></td>
            <% } else { %><td>—</td><% } %>

            <td>
              <%
                const s = (license.status || '').toLowerCase();
                const cls = ['active','expired','pending','inactive'].includes(s) ? s : 'default';
              %>
              <span class="status-pill <%= cls %>"><%= license.status %></span>
            </td>

            <% if (license.expiration_date) { %>
              <td><%= new Date(license.expiration_date).toISOString().slice(0,10).replace(/-/g,'/') %></td>
            <% } else { %><td>—</td><% } %>

            <td><button class="action-btn renew" onclick="window.location='/renew/<%= license.userid %>'">Renew</button></td>
            <td><button class="action-btn deactivate" onclick="window.location='/deactivate/<%= license.userid %>'">Deactivate</button></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>

  <div class="footer">© Business Executive</div>

</body>
</html>
