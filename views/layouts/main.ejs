<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Business Executive" %></title>
  <% if (typeof stylesheet !== 'undefined' && stylesheet) { %>
    <link rel="stylesheet" href="<%= stylesheet %>">
  <% } %>
  <% if (typeof headFile !== 'undefined' && headFile) { %>
    <%- include(headFile) %>
  <% } %>
</head>
<body>
  <% if (typeof bodyFile !== 'undefined' && bodyFile) { %>
    <%- include(bodyFile) %>
  <% } %>
</body>
</html>
