<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Registration Details</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cyan:        #00BDD6;
      --cyan-dark:   #0099B0;
      --cyan-glow:   rgba(0,189,214,0.10);
      --ink:         #0B1120;
      --ink-soft:    #2E3A4A;
      --muted:       #6B7A8D;
      --surface:     #F2F6FA;
      --card-bg:     #FFFFFF;
      --border:      rgba(0,189,214,0.18);
      --danger:      #E53935;
      --danger-dark: #B71C1C;
      --radius-lg:   16px;
      --radius-md:   10px;
      --shadow-sm:   0 2px 10px rgba(11,17,32,0.06);
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--surface);
      color: var(--ink-soft);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── Header ─────────────────────────────────── */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 36px;
      height: 64px;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-title {
      font-family: 'Syne', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--ink);
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .header-actions { display: flex; gap: 10px; align-items: center; }

    .btn {
      display: inline-flex;
      align-items: center;
      padding: 8px 18px;
      border-radius: var(--radius-md);
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.18s, transform 0.12s;
    }

    .btn:hover { transform: translateY(-1px); }
    .btn-back  { background: var(--cyan-glow); color: var(--cyan-dark); border: 1px solid var(--border); }
    .btn-back:hover { background: rgba(0,189,214,0.20); }
    .btn-logout { background: var(--danger); color: #fff; }
    .btn-logout:hover { background: var(--danger-dark); }

    /* ── Content ────────────────────────────────── */
    .content {
      flex: 1;
      padding: 36px 40px 80px;
      max-width: 780px;
      width: 100%;
      margin: 0 auto;
      animation: fadeUp 0.45s ease both;
    }

    /* ── Details Card ───────────────────────────── */
    .details-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: 0 4px 20px rgba(11,17,32,0.07);
      overflow: hidden;
      margin-bottom: 28px;
    }

    .details-card-header {
      padding: 16px 24px;
      background: linear-gradient(90deg, var(--cyan) 0%, var(--cyan-dark) 100%);
    }

    .details-card-header h2 {
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .details-table {
      width: 100%;
      border-collapse: collapse;
    }

    .details-table tr {
      border-bottom: 1px solid rgba(0,189,214,0.09);
    }

    .details-table tr:last-child { border-bottom: none; }
    .details-table tr:nth-child(even) { background: rgba(242,246,250,0.6); }

    .details-table td {
      padding: 14px 24px;
      font-size: 0.87rem;
    }

    .details-table td:first-child {
      width: 38%;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--muted);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .details-table td:last-child {
      color: var(--ink-soft);
      font-weight: 500;
    }

    /* ── Action Buttons ─────────────────────────── */
    .action-buttons {
      display: flex;
      gap: 14px;
      justify-content: center;
    }

    .approve-btn, .reject-btn {
      padding: 11px 32px;
      border-radius: var(--radius-md);
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.18s, transform 0.12s;
    }

    .approve-btn:hover, .reject-btn:hover { transform: translateY(-2px); }

    .approve-btn { background: var(--cyan); color: #fff; }
    .approve-btn:hover { background: var(--cyan-dark); }

    .reject-btn { background: var(--danger); color: #fff; }
    .reject-btn:hover { background: var(--danger-dark); }

    /* ── Footer ─────────────────────────────────── */
    .footer {
      background: var(--cyan);
      color: #fff;
      text-align: center;
      position: fixed;
      bottom: 0; left: 0;
      width: 100%;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 500;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <div class="header">
    <a href="/companyregapplications" class="btn btn-back">← Back</a>
    <span class="header-title">Application Details</span>
    <div class="header-actions">
      <form action="/logout?_method=DELETE" method="POST">
        <button class="btn btn-logout" type="submit">Logout</button>
      </form>
    </div>
  </div>

  <div class="content">

    <div class="details-card">
      <div class="details-card-header">
        <h2>Company Information</h2>
      </div>
      <table class="details-table">
        <tbody>
          <tr>
            <td>User ID</td>
            <td><%= application.userid %></td>
          </tr>
          <tr>
            <td>Company Name</td>
            <td><%= application.company_name %></td>
          </tr>
          <tr>
            <td>Company Email</td>
            <td><%= application.email %></td>
          </tr>
          <tr>
            <td>Address</td>
            <td><%= application.address %></td>
          </tr>
          <tr>
            <td>Telephone</td>
            <td><%= application.telephone %></td>
          </tr>
          <tr>
            <td>Accounting Software</td>
            <td><%= application.accounting_software %></td>
          </tr>
          <tr>
            <td>Products / Services</td>
            <td><%= application.company_services %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="action-buttons">
      <form action="/companyregdetails/approveUser/<%= application.userid %>" method="POST" style="display:inline;">
        <button type="submit" class="approve-btn">✓ Approve</button>
      </form>
      <form action="/companyregdetails/rejectUser/<%= application.userid %>" method="POST" style="display:inline;">
        <button type="submit" class="reject-btn">✕ Reject</button>
      </form>
    </div>

  </div>

  <div class="footer">© Business Executive</div>

</body>
</html>
